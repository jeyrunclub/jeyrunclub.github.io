---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (p: string) => path === p;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="جیران">
      <img src="/images/logo.png" alt="لوگوی تیم جیران" class="brand-logo" />
      <span class="brand-name">جیران</span>
    </a>
    <nav class="site-nav" aria-label="فهرست اصلی">
      <a href="/" class:list={[isActive('/') && 'active']}>خانه</a>
      <a href="/coach" class:list={[isActive('/coach') && 'active']}>مربی</a>
      <a href="/services" class:list={[isActive('/services') && 'active']}>خدمات</a>
      <a href="/races" class:list={[isActive('/races') && 'active']}>مسابقات</a>
      <a href="/calendar" class:list={[isActive('/calendar') && 'active']}>تقویم</a>
      <a href="/gallery" class:list={[isActive('/gallery') && 'active']}>گالری</a>
      <a href="/blog" class:list={[path.startsWith('/blog') && 'active']}>بلاگ</a>
      <a href="/#join" class="nav-cta">عضویت</a>
    </nav>
    <button class="nav-toggle" aria-label="باز کردن فهرست" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
