---
/**
 * One articulated runner, side on, facing right — a body in kit, not a
 * skeleton.
 *
 * Still a rig: hips, knees, ankles, shoulders and elbows are groups the CSS
 * rotates, so this is a real run cycle. What changed is that each limb is a
 * thick round-capped stroke rather than a hairline, which reads as an arm or a
 * leg with mass; a second, shorter stroke laid over the top of the upper arm
 * and the thigh is the sleeve and the short. Torso, head and hair are filled
 * shapes.
 *
 * `transform-box: view-box` is what makes the joints work — without it a
 * transform-origin resolves against each element's own bounding box and every
 * limb pivots around its own middle instead of its joint.
 *
 * Kit colours come from the club's own palette rather than a generic athletic
 * one, and each figure takes its own, so a pack doesn't read as a uniform.
 */

interface Props {
  shirt?: string;
  shorts?: string;
  skin?: string;
  hair?: string;
  shoe?: string;
  /**
   * Full-length leggings, in the club's photographs worn by most of the women
   * and by nobody in shorts. Set it and the legs are drawn in fabric rather
   * than skin; leave it off for bare legs.
   */
  tights?: string;
  /**
   * Short hair, a ponytail, a bun or hair worn loose. Caps exist in the club's
   * photographs but are rare — one or two people across all of them — so they
   * are not the default for anybody.
   */
  head?: 'short' | 'cap' | 'ponytail' | 'bun' | 'long';
  delay?: number;
  stride?: number;
  class?: string;
}

const {
  shirt = '#17130f',
  shorts = '#1d3f77',
  skin = '#d9a677',
  hair = '#17130f',
  shoe = '#e00a2e',
  tights,
  head = 'short',
  delay = 0,
  stride = 0.62,
  class: className,
} = Astro.props;
---

<svg
  class:list={['runner-fig', className]}
  viewBox="0 0 76 120"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={`--delay:${delay}s;--stride:${stride}s`}
  aria-hidden="true"
>
  <g class="rf-bob">
    {/* ---- far side, behind the body ---- */}
    <g class="rf-arm rf-arm--far" style="transform-origin:38px 32px">
      <path d="M38 32 38 49" stroke={skin} stroke-width="8.6" />
      <path d="M38 32 38 41" stroke={shirt} stroke-width="11.4" />
      <g class="rf-forearm rf-forearm--far" style="transform-origin:38px 49px">
        <path d="M38 49 38 63" stroke={skin} stroke-width="7.2" />
      </g>
    </g>
    <g class="rf-thigh rf-thigh--far" style="transform-origin:35px 62px">
      <path d="M35 62 35 87" stroke={tights ?? skin} stroke-width="11" />
      <path d="M35 62 35 73" stroke={shorts} stroke-width="13" />
      <g class="rf-shin rf-shin--far" style="transform-origin:35px 87px">
        <path d="M35 87 35 106" stroke={tights ?? skin} stroke-width="8.6" />
        <g class="rf-foot rf-foot--far" style="transform-origin:35px 106px">
          <path d="M35 106 43 109" stroke={shoe} stroke-width="7.2" />
        </g>
      </g>
    </g>

    {/* ---- torso and head ---- */}
    {/* The shirt: shoulders down to the hip, leaning forward with the run. */}
    <path
      fill={shirt}
      d="M31.8 28.4C34.4 24.6 43.8 24.4 46.4 28.2C48.2 30.8 46.4 35.2 44.4 40C42.8 44 41.4 47.8 40.8 51.4C40.3 54.6 40.1 58.4 40.1 60.2C40.1 62.6 38.4 63.8 35 63.8C31.4 63.8 29.9 62.2 30.3 59.4C30.7 56.4 31.3 52.2 31.4 48.4C31.6 43.2 31.2 37 30.8 32.8C30.5 30 30.8 29.8 31.8 28.4Z"
    />
    <path d="M40 27 42.5 22" stroke={skin} stroke-width="7.2" />
    <circle cx="46" cy="16" r="9.4" fill={skin} />

    {/* Hair over the crown and back of the head. */}
    {head === 'cap' ? (
      <>
        <path fill={hair} d="M36.8 14C37.8 8.4 42.4 5.6 47 6.2C51 6.8 54 9.6 54.4 13.4C50 11.8 41.4 12.2 36.8 14Z" />
        <path fill={hair} d="M54.3 12.4C57.6 12.6 59.6 13.4 60.2 14.6C57.6 15.2 55 15.2 54.1 14.8Z" />
      </>
    ) : (
      <path fill={hair} d="M36.8 15C36.4 9.6 40.6 5.8 45.6 5.8C50.4 5.8 54.4 9 54.8 13.6C51.4 10.6 41.6 11 36.8 15Z" />
    )}
    {head === 'ponytail' && (
      <path
        fill={hair}
        d="M38.4 12.8C34 12.6 29.6 15 27.2 19.4C25.8 22 25.6 24.8 26.6 26.6C28.6 25 30.4 22.6 32.4 20C34.2 17.6 36.2 15.6 38.8 14.6Z"
      />
    )}
    {head === 'bun' && <circle cx="34.8" cy="11" r="4.8" fill={hair} />}
    {head === 'long' && (
      <path
        fill={hair}
        d="M38.6 12.4C34.6 12.6 31.6 15.2 30.4 19.2C29.4 22.6 29.8 26.4 31.2 29.6C33.6 28.4 35 25.8 35.8 22.6C36.6 19.2 37.2 15.6 38.8 14Z"
      />
    )}

    {/* ---- near side, in front ---- */}
    <g class="rf-thigh rf-thigh--near" style="transform-origin:35px 62px">
      <path d="M35 62 35 87" stroke={tights ?? skin} stroke-width="11" />
      <path d="M35 62 35 73" stroke={shorts} stroke-width="13" />
      <g class="rf-shin rf-shin--near" style="transform-origin:35px 87px">
        <path d="M35 87 35 106" stroke={tights ?? skin} stroke-width="8.6" />
        <g class="rf-foot rf-foot--near" style="transform-origin:35px 106px">
          <path d="M35 106 43 109" stroke={shoe} stroke-width="7.2" />
        </g>
      </g>
    </g>
    <g class="rf-arm rf-arm--near" style="transform-origin:38px 32px">
      <path d="M38 32 38 49" stroke={skin} stroke-width="8.6" />
      <path d="M38 32 38 41" stroke={shirt} stroke-width="11.4" />
      <g class="rf-forearm rf-forearm--near" style="transform-origin:38px 49px">
        <path d="M38 49 38 63" stroke={skin} stroke-width="7.2" />
      </g>
    </g>
  </g>
</svg>

<style is:global>
  .runner-fig { overflow: visible; }
  .runner-fig g { transform-box: view-box; }

  /* The far arm and leg are the same shapes in the same place as the near
     ones, so a mirrored swap between them was invisible — the figure looked
     frozen even though every joint was moving. Darkening the far side both
     reads as depth and makes the cycle legible. */
  .runner-fig .rf-arm--far,
  .runner-fig .rf-thigh--far { filter: brightness(0.74); }

  .runner-fig .rf-bob,
  .runner-fig .rf-thigh,
  .runner-fig .rf-shin,
  .runner-fig .rf-foot,
  .runner-fig .rf-arm,
  .runner-fig .rf-forearm {
    animation-duration: var(--stride);
    animation-delay: var(--delay);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  /* Two footfalls per cycle, so the body rises and falls twice. */
  .runner-fig .rf-bob {
    animation-name: rf-bob;
    animation-duration: calc(var(--stride) / 2);
    transform-box: view-box;
  }

  .runner-fig .rf-thigh--near    { animation-name: rf-thigh; }
  .runner-fig .rf-thigh--far     { animation-name: rf-thigh-far; }
  .runner-fig .rf-shin--near     { animation-name: rf-shin; }
  .runner-fig .rf-shin--far      { animation-name: rf-shin-far; }
  .runner-fig .rf-foot--near     { animation-name: rf-foot; }
  .runner-fig .rf-foot--far      { animation-name: rf-foot-far; }
  .runner-fig .rf-arm--near      { animation-name: rf-arm; }
  .runner-fig .rf-arm--far       { animation-name: rf-arm-far; }
  .runner-fig .rf-forearm--near  { animation-name: rf-forearm; }
  .runner-fig .rf-forearm--far   { animation-name: rf-forearm-far; }

  /* Negative rotations swing a downward limb forwards, towards +x. */
  @keyframes rf-bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-3px); }
  }

  @keyframes rf-thigh {
    0%   { transform: rotate(-34deg); }
    25%  { transform: rotate(-8deg); }
    50%  { transform: rotate(28deg); }
    75%  { transform: rotate(4deg); }
    100% { transform: rotate(-34deg); }
  }
  @keyframes rf-thigh-far {
    0%   { transform: rotate(28deg); }
    25%  { transform: rotate(4deg); }
    50%  { transform: rotate(-34deg); }
    75%  { transform: rotate(-8deg); }
    100% { transform: rotate(28deg); }
  }

  /* The shin trails the thigh: nearly straight as the foot reaches out,
     folded right up as the heel comes through under the hip. */
  @keyframes rf-shin {
    0%   { transform: rotate(24deg); }
    20%  { transform: rotate(2deg); }
    50%  { transform: rotate(50deg); }
    72%  { transform: rotate(94deg); }
    100% { transform: rotate(24deg); }
  }
  @keyframes rf-shin-far {
    0%   { transform: rotate(50deg); }
    22%  { transform: rotate(94deg); }
    50%  { transform: rotate(24deg); }
    70%  { transform: rotate(2deg); }
    100% { transform: rotate(50deg); }
  }

  @keyframes rf-foot {
    0%   { transform: rotate(-14deg); }
    50%  { transform: rotate(16deg); }
    100% { transform: rotate(-14deg); }
  }
  @keyframes rf-foot-far {
    0%   { transform: rotate(16deg); }
    50%  { transform: rotate(-14deg); }
    100% { transform: rotate(16deg); }
  }

  /* Arms oppose the legs. */
  @keyframes rf-arm {
    0%   { transform: rotate(40deg); }
    50%  { transform: rotate(-38deg); }
    100% { transform: rotate(40deg); }
  }
  @keyframes rf-arm-far {
    0%   { transform: rotate(-38deg); }
    50%  { transform: rotate(40deg); }
    100% { transform: rotate(-38deg); }
  }

  /* The elbow closes as the hand comes up past the chest and opens as it
     drives back past the hip. Holding it near a right angle the whole way
     round left both forearms horizontal and the arms looked stiff. */
  @keyframes rf-forearm {
    0%   { transform: rotate(-108deg); }
    50%  { transform: rotate(-46deg); }
    100% { transform: rotate(-108deg); }
  }
  @keyframes rf-forearm-far {
    0%   { transform: rotate(-46deg); }
    50%  { transform: rotate(-108deg); }
    100% { transform: rotate(-46deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .runner-fig * { animation: none !important; }
  }
</style>
