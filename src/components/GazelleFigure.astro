---
/**
 * The gazelle, articulated, side on and facing right.
 *
 * The club mark is a filled ribbon — beautiful, but a single closed shape with
 * nothing in it to move. This is a separate drawing built as a rig: shoulder,
 * elbow, hip and hock are groups the CSS rotates, so it gallops rather than
 * slides. Drawn in the same line language as the runners, in crimson, so the
 * two read as one scene without this pretending to be the logo.
 *
 * A gallop is not a run cycle with four legs: the fore pair and the hind pair
 * each work close to together, a beat apart, with a moment of suspension where
 * the whole animal is off the ground. That is what the body keyframes do —
 * one rise per stride, not two.
 */

interface Props {
  delay?: number;
  stride?: number;
  class?: string;
}
const { delay = 0, stride = 0.62, class: className } = Astro.props;
---

<svg
  class:list={['gazelle-fig', className]}
  viewBox="0 0 106 82"
  fill="none"
  stroke="currentColor"
  stroke-width="4.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={`--delay:${delay}s;--stride:${stride}s`}
  aria-hidden="true"
>
  <g class="gz-body">
    {/* Far pair first, so the near pair reads in front of them. */}
    <g class="gz-fore gz-fore--far" style="transform-origin:68px 34px">
      <path d="M68 34 68 51" />
      <g class="gz-forelow gz-forelow--far" style="transform-origin:68px 51px">
        <path d="M68 51 68 68" />
        <path d="M68 68 72 71" />
      </g>
    </g>
    <g class="gz-hind gz-hind--far" style="transform-origin:26px 36px">
      <path d="M26 36 26 51" />
      <g class="gz-hindlow gz-hindlow--far" style="transform-origin:26px 51px">
        <path d="M26 51 26 68" />
        <path d="M26 68 30 71" />
      </g>
    </g>

    {/* The mark is a filled ribbon, and a single-stroke skeleton next to it
        read as a stick insect. Barrel, neck and head are filled shapes so the
        animal has mass; only the legs stay strokes, because those are what
        rotate. */}
    <path
      fill="currentColor" stroke="none"
      d="M25 32C37 27 56 26.5 67.5 30C73.5 32 76 36.5 72 40C64 45.5 39 46 30 42.5C25.5 40.7 23 35.5 25 32Z"
    />
    <path
      fill="currentColor" stroke="none"
      d="M65 32C69.5 25.5 75 19 79.5 14.5C82 12 85 11 88 11.5C93 12.3 98.5 16 99.5 19.8C100.2 22.4 97 24.2 93 23.4L87 22.2C84 23 79.5 26.5 74 33Z"
    />
    {/* Horns, swept back over the shoulders. */}
    <path d="M86 10C89.5 5 92 2.5 95 0.6" stroke-width="3" />
    <path d="M83 10.4C85.5 5.6 87.5 3 89.5 1.4" stroke-width="3" />
    {/* Ear, laid back the way it is at speed. */}
    <path fill="currentColor" stroke="none" d="M80 15.5C77 13.8 74.5 13.6 72.5 14.4C74.5 16.6 77 17.6 79.5 17.4Z" />
    <g class="gz-tail" style="transform-origin:26px 36px">
      <path d="M27 37C22 38 18 41 16 45" stroke-width="3.2" />
    </g>

    {/* Near pair */}
    <g class="gz-hind gz-hind--near" style="transform-origin:26px 36px">
      <path d="M26 36 26 51" />
      <g class="gz-hindlow gz-hindlow--near" style="transform-origin:26px 51px">
        <path d="M26 51 26 68" />
        <path d="M26 68 30 71" />
      </g>
    </g>
    <g class="gz-fore gz-fore--near" style="transform-origin:68px 34px">
      <path d="M68 34 68 51" />
      <g class="gz-forelow gz-forelow--near" style="transform-origin:68px 51px">
        <path d="M68 51 68 68" />
        <path d="M68 68 72 71" />
      </g>
    </g>
  </g>
</svg>

<style is:global>
  .gazelle-fig { overflow: visible; }
  .gazelle-fig g { transform-box: view-box; }

  /* Same reason as the runners: an unshaded far pair makes the near pair's
     swing invisible, because they are identical strokes in the same place. */
  .gazelle-fig .gz-fore--far,
  .gazelle-fig .gz-hind--far { opacity: 0.4; }

  .gazelle-fig .gz-body,
  .gazelle-fig .gz-fore,
  .gazelle-fig .gz-forelow,
  .gazelle-fig .gz-hind,
  .gazelle-fig .gz-hindlow,
  .gazelle-fig .gz-tail {
    animation-duration: var(--stride);
    animation-delay: var(--delay);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .gazelle-fig .gz-body { animation-name: gz-bound; }
  .gazelle-fig .gz-tail { animation-name: gz-tail; }
  .gazelle-fig .gz-fore--near    { animation-name: gz-fore; }
  .gazelle-fig .gz-fore--far     { animation-name: gz-fore-far; }
  .gazelle-fig .gz-forelow--near { animation-name: gz-forelow; }
  .gazelle-fig .gz-forelow--far  { animation-name: gz-forelow-far; }
  .gazelle-fig .gz-hind--near    { animation-name: gz-hind; }
  .gazelle-fig .gz-hind--far     { animation-name: gz-hind-far; }
  .gazelle-fig .gz-hindlow--near { animation-name: gz-hindlow; }
  .gazelle-fig .gz-hindlow--far  { animation-name: gz-hindlow-far; }

  /* One suspension per stride, with the body pitching nose-up as the hind
     legs drive and settling as the forelegs land. */
  @keyframes gz-bound {
    0%   { transform: translateY(0) rotate(0deg); }
    30%  { transform: translateY(-7px) rotate(-5deg); }
    55%  { transform: translateY(-2px) rotate(1deg); }
    100% { transform: translateY(0) rotate(0deg); }
  }

  @keyframes gz-fore {
    0%   { transform: rotate(-52deg); }
    30%  { transform: rotate(-14deg); }
    60%  { transform: rotate(34deg); }
    100% { transform: rotate(-52deg); }
  }
  @keyframes gz-fore-far {
    0%   { transform: rotate(-34deg); }
    30%  { transform: rotate(4deg); }
    60%  { transform: rotate(44deg); }
    100% { transform: rotate(-34deg); }
  }
  /* A foreleg folds tight under the chest as it comes through. */
  @keyframes gz-forelow {
    0%   { transform: rotate(46deg); }
    30%  { transform: rotate(10deg); }
    60%  { transform: rotate(-4deg); }
    100% { transform: rotate(46deg); }
  }
  @keyframes gz-forelow-far {
    0%   { transform: rotate(30deg); }
    30%  { transform: rotate(2deg); }
    60%  { transform: rotate(4deg); }
    100% { transform: rotate(30deg); }
  }

  @keyframes gz-hind {
    0%   { transform: rotate(40deg); }
    30%  { transform: rotate(48deg); }
    62%  { transform: rotate(-44deg); }
    100% { transform: rotate(40deg); }
  }
  @keyframes gz-hind-far {
    0%   { transform: rotate(30deg); }
    30%  { transform: rotate(44deg); }
    62%  { transform: rotate(-34deg); }
    100% { transform: rotate(30deg); }
  }
  /* The hock closes hard on the gather and snaps open on the drive. */
  @keyframes gz-hindlow {
    0%   { transform: rotate(-30deg); }
    30%  { transform: rotate(-46deg); }
    62%  { transform: rotate(52deg); }
    100% { transform: rotate(-30deg); }
  }
  @keyframes gz-hindlow-far {
    0%   { transform: rotate(-24deg); }
    30%  { transform: rotate(-40deg); }
    62%  { transform: rotate(44deg); }
    100% { transform: rotate(-24deg); }
  }

  @keyframes gz-tail {
    0%   { transform: rotate(-8deg); }
    50%  { transform: rotate(12deg); }
    100% { transform: rotate(-8deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gazelle-fig * { animation: none !important; }
  }
</style>
