---
import { footer, type Lang } from '../i18n/nav';

export interface Props {
  lang?: Lang;
}
const { lang = 'fa' } = Astro.props;
const t = footer[lang];
const homeHref = lang === 'fa' ? '/' : '/en';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <img src="/images/logo.png" alt={lang === 'fa' ? 'جیران' : 'Jeyrun'} class="footer-logo" />
      <p class="footer-team">{t.tagline}</p>
    </div>
    <ul class="social">
      <li><a href={homeHref}>{t.home}</a></li>
      <li><a href="/blog">{t.blog}</a></li>
      <li><a href="https://www.instagram.com/salar.piri" target="_blank" rel="noopener">{t.igSalar}</a></li>
      <li><a href="https://www.instagram.com/jeyrun_club" target="_blank" rel="noopener">{t.igClub}</a></li>
      <li><a href="https://www.strava.com/athletes/33620923" target="_blank" rel="noopener">{t.strava}</a></li>
    </ul>
    <p class="copy">{t.copy}</p>
  </div>
</footer>
