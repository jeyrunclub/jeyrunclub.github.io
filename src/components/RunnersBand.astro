---
// The club running two abreast, in file, with the gazelle in among them.
//
// Side on, "two abreast" is a depth problem rather than a horizontal one: the
// pair share a position along the street, so the far one is drawn higher up the
// band, a little smaller and hazed back towards the paper. Draw order is far
// file → gazelle → near file, which puts the gazelle inside the group: the near
// rank passes in front of it, the far rank behind.
//
// Every figure is a rig whose joints CSS rotates (RunnerFigure.astro and
// GazelleFigure.astro); this file dresses them, ranks them and carries them
// across.
//
// Kit is read off the club's own photographs rather than invented: the men in
// shorts, the women in full-length leggings with ponytails, buns and caps —
// which is what everybody in the group shots is actually wearing.
//
// Decorative, so the whole strip is aria-hidden. It also breaks the page's
// rhythm on purpose: every other section is eyebrow → heading → grid inside the
// same container, and this one is edge to edge with nothing but movement.

import RunnerFigure from './RunnerFigure.astro';
import GazelleFigure from './GazelleFigure.astro';

const INK = '#17130f';
const SAND = '#efe7d8';
const WHITE = '#fbf7ef';
const NAVY = '#1d3f77';

type Kit = {
  shirt: string; shorts: string; skin: string; hair: string; shoe: string;
  tights?: string;
  head: 'short' | 'cap' | 'ponytail' | 'bun' | 'long';
  stride: number;
};

/**
 * Read off the club's own group photographs rather than invented, and corrected
 * after a first pass that made everyone look like a stock athletics set:
 *
 *  - Hair is dark, near enough universally. There was a grey-haired runner in
 *    here; there is nobody grey in the photographs.
 *  - Caps are rare — one or two people across every group shot — so there is
 *    one, not three.
 *  - The kit is far brighter than black-and-navy: orange, white, turquoise,
 *    pink, light blue and yellow are all over the group photographs, and white
 *    tops are the single most common thing anybody wears.
 *  - Six of the ten are women, which is about the ratio in the photographs.
 */
const kits: Kit[] = [
  // women — leggings, hair up or loose
  { shirt: WHITE,     shorts: INK,  tights: INK,       skin: '#e8c49b', hair: '#1b120c', shoe: '#e00a2e', head: 'ponytail', stride: 0.60 },
  { shirt: '#e2618f', shorts: INK,  tights: INK,       skin: '#d9a677', hair: '#241811', shoe: WHITE,     head: 'bun',      stride: 0.64 },
  { shirt: '#0d8f8b', shorts: NAVY, tights: NAVY,      skin: '#c98d5e', hair: '#1b120c', shoe: WHITE,     head: 'ponytail', stride: 0.62 },
  { shirt: '#7fb2d9', shorts: INK,  tights: INK,       skin: '#e8c49b', hair: '#2b1d14', shoe: '#0d8f8b', head: 'long',     stride: 0.66 },
  { shirt: INK,       shorts: INK,  tights: '#0d8f8b', skin: '#d9a677', hair: '#1b120c', shoe: WHITE,     head: 'bun',      stride: 0.59 },
  { shirt: '#e00a2e', shorts: INK,  tights: INK,       skin: '#c98d5e', hair: '#241811', shoe: INK,       head: 'ponytail', stride: 0.63 },
  // men — shorts
  { shirt: '#e8622a', shorts: INK,  skin: '#c98d5e', hair: '#1b120c', shoe: WHITE,     head: 'short', stride: 0.58 },
  { shirt: WHITE,     shorts: NAVY, skin: '#d9a677', hair: '#241811', shoe: '#e00a2e', head: 'short', stride: 0.61 },
  { shirt: '#eda600', shorts: INK,  skin: '#e8c49b', hair: '#1b120c', shoe: INK,       head: 'cap',   stride: 0.65 },
  { shirt: INK,       shorts: SAND, skin: '#c98d5e', hair: '#1b120c', shoe: '#0d8f8b', head: 'short', stride: 0.62 },
];

// Mix the two files so a rank isn't all women or all men, the way the group
// photographs show people paired up however they happen to be running.
const order = [0, 6, 1, 7, 2, 8, 3, 9, 4, 5];

// Five ranks of two. More negative delay is further along the street, so the
// leading pair is first. The far runner of each pair trails by a hair, because
// nobody holds a perfect line.
//
// STEP is the gap between ranks, in seconds of the crossing. At 0.62 the group
// was strung out over most of the band with daylight between every rank, which
// is not how a group runs — 0.38 puts them about a figure's width apart, close
// enough to be one pack.
const PAIRS = 5;
const STEP = 0.38;
const ranks = Array.from({ length: PAIRS }, (_, i) => {
  const d = -(2.4 - i * STEP);
  return {
    near: kits[order[i * 2]],
    far: kits[order[i * 2 + 1]],
    nearDelay: d,
    farDelay: d + 0.05,
  };
});

// Out in front of the whole group — but placed between the two files in depth
// rather than in either of them, so it leads the column down the middle.
const GAZELLE_DELAY = -2.82;
---
<div class="runners-band" aria-hidden="true">
  <span class="runners-ground"></span>

  {/* Far file first. */}
  {ranks.map((r) => (
    <span class="runner runner--person runner--far" style={`--d:${r.farDelay}s`}>
      <RunnerFigure {...r.far} delay={r.farDelay} />
    </span>
  ))}

  {/* Drawn between the files: the near rank passes in front of it, the far
      rank behind, so it runs up the middle of the column rather than in one
      line or the other. */}
  <span class="runner runner--gazelle" style={`--d:${GAZELLE_DELAY}s`}>
    <GazelleFigure delay={-0.2} stride={0.58} />
  </span>

  {/* Near file last, so it passes in front of everything. */}
  {ranks.map((r) => (
    <span class="runner runner--person runner--near" style={`--d:${r.nearDelay}s`}>
      <RunnerFigure {...r.near} delay={r.nearDelay} />
    </span>
  ))}
</div>
