---
// The gazelle out in front, Salar behind it, the club behind him — all
// articulated now rather than sliding images.
//
// Each figure is a rig whose joints CSS rotates (see RunnerFigure.astro and
// GazelleFigure.astro); this file only places them and carries them across.
// The runners wear the club's own faces, clipped into the head circle, so the
// pack is recognisably us and not a stock silhouette.
//
// Decorative, so the whole strip is aria-hidden. It also breaks the page's
// rhythm on purpose: every other section is eyebrow → heading → grid inside
// the same container, and this one is edge to edge with nothing but movement.

import RunnerFigure from './RunnerFigure.astro';
import GazelleFigure from './GazelleFigure.astro';

// Only members photographed face-on: the fourth portrait we have is shot from
// behind, which reads oddly on a figure running towards the right.
const pack = [
  { photo: '/images/runners/salar.jpg',    cls: 'runner--1', delay: -0.31, stride: 0.60 },
  { photo: '/images/runners/member-1.jpg', cls: 'runner--2', delay: -0.08, stride: 0.66 },
  { photo: '/images/runners/member-3.jpg', cls: 'runner--3', delay: -0.44, stride: 0.63 },
];
---
<div class="runners-band" aria-hidden="true">
  <span class="runners-ground"></span>

  <span class="runner runner--gazelle">
    <GazelleFigure delay={-0.2} stride={0.58} />
  </span>

  {pack.map((p) => (
    <span class:list={['runner', 'runner--face', p.cls]}>
      <RunnerFigure photo={p.photo} delay={p.delay} stride={p.stride} />
    </span>
  ))}
</div>
