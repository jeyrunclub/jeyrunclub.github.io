---
// The gazelle out in front, Salar behind it, the club behind him.
//
// The followers were line figures to begin with; they are the club's own
// photographs now, because generic stick figures could have been any club.
// The portraits are cropped from the gallery and the team folder — the same
// pictures that appear elsewhere on the site.
//
// Decorative, so the whole strip is aria-hidden. It also breaks the page's
// rhythm on purpose: every other section is eyebrow → heading → grid inside
// the same container, and this one is edge to edge with nothing in it but
// movement.

import { Image } from 'astro:assets';
import salar from '../assets/runners/salar.jpg';
import member1 from '../assets/runners/member-1.jpg';
import member2 from '../assets/runners/member-2.jpg';
import member3 from '../assets/runners/member-3.jpg';

const pack = [
  { src: salar,   alt: '', size: 76, cls: 'runner--1' },
  { src: member1, alt: '', size: 66, cls: 'runner--2' },
  { src: member2, alt: '', size: 62, cls: 'runner--3' },
  { src: member3, alt: '', size: 58, cls: 'runner--4' },
];
---
<div class="runners-band" aria-hidden="true">
  <span class="runners-ground"></span>

  <span class="runner runner--gazelle">
    <span class="runner-bob">
      <img src="/images/logo.png" alt="" width="88" height="71" />
    </span>
  </span>

  {pack.map((p) => (
    <span class:list={['runner', 'runner--face', p.cls]}>
      <span class="runner-bob">
        <Image
          src={p.src}
          alt={p.alt}
          width={p.size * 2}
          height={p.size * 2}
          quality={80}
          loading="lazy"
          style={`width:${p.size}px;height:${p.size}px`}
        />
      </span>
    </span>
  ))}
</div>
