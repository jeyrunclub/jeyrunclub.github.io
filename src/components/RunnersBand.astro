---
// The club running two abreast, in file, with the gazelle in among them.
//
// Side on, "two abreast" is a depth problem rather than a horizontal one: the
// pair share a position along the street, so the far one is drawn higher up the
// band, a little smaller and hazed back towards the paper. Draw order is far
// file → gazelle → near file, which puts the gazelle inside the group: the near
// rank passes in front of it, the far rank behind.
//
// Every figure is a rig whose joints CSS rotates (RunnerFigure.astro and
// GazelleFigure.astro); this file dresses them, ranks them and carries them
// across.
//
// Kit is read off the club's own photographs rather than invented: the men in
// shorts, the women in full-length leggings with their hair up or loose, which
// is what everybody in the group shots is actually wearing.
//
// Decorative, so the whole strip is aria-hidden. It also breaks the page's
// rhythm on purpose: every other section is eyebrow → heading → grid inside the
// same container, and this one is edge to edge with nothing but movement.

import RunnerFigure from './RunnerFigure.astro';
import GazelleFigure from './GazelleFigure.astro';

const INK = '#17130f';
const SAND = '#efe7d8';
const WHITE = '#fbf7ef';
const NAVY = '#1d3f77';

type Kit = {
  shirt: string; shorts: string; skin: string; hair: string; shoe: string;
  tights?: string;
  head: 'short' | 'cap' | 'ponytail' | 'bun' | 'long';
  stride: number;
};

/**
 * Read off the club's own photographs. Corrected three times: a grey-haired
 * runner and three caps in the first pass (nobody in the photographs is grey,
 * and caps are rare enough that none of the ten wears one now), a black-and-navy
 * palette in the second (the club wears orange, white, turquoise, pink, light
 * blue, neon and mint), and a stocky build in the third — these are people who
 * train, so the figure itself is leaner and longer in the leg.
 *
 * Five women, five men, and the two files are ordered so every rank is one of
 * each.
 */
const women: Kit[] = [
  { shirt: INK,       shorts: INK,  tights: INK,       skin: '#e8c49b', hair: '#8a6a45', shoe: WHITE,     head: 'long',     stride: 0.60 },
  { shirt: WHITE,     shorts: INK,  tights: INK,       skin: '#d9a677', hair: '#1b120c', shoe: '#e00a2e', head: 'ponytail', stride: 0.64 },
  { shirt: '#0d8f8b', shorts: NAVY, tights: NAVY,      skin: '#c98d5e', hair: '#1b120c', shoe: WHITE,     head: 'bun',      stride: 0.62 },
  { shirt: '#e2618f', shorts: INK,  tights: INK,       skin: '#e8c49b', hair: '#241811', shoe: WHITE,     head: 'ponytail', stride: 0.66 },
  { shirt: INK,       shorts: INK,  tights: '#0d8f8b', skin: '#d9a677', hair: '#1b120c', shoe: INK,       head: 'long',     stride: 0.59 },
];

const men: Kit[] = [
  { shirt: '#c8e14f', shorts: INK,  skin: '#d9a677', hair: '#1b120c', shoe: WHITE,     head: 'short', stride: 0.58 },
  { shirt: '#a9cbb2', shorts: SAND, skin: '#c98d5e', hair: '#241811', shoe: '#0d8f8b', head: 'short', stride: 0.61 },
  { shirt: INK,       shorts: INK,  skin: '#e8c49b', hair: '#1b120c', shoe: '#e00a2e', head: 'short', stride: 0.65 },
  { shirt: '#e8622a', shorts: INK,  skin: '#c98d5e', hair: '#1b120c', shoe: INK,       head: 'short', stride: 0.63 },
  { shirt: '#8e9298', shorts: INK,  skin: '#d9a677', hair: '#241811', shoe: WHITE,     head: 'short', stride: 0.62 },
];

// Mixed, not sorted. Alternating strictly put every woman in the near file and
// every man in the far one, which read as two separate groups running side by
// side. This order gives mixed ranks, a pair of women and a pair of men — the
// way a group actually strings out. Fixed rather than random so the build is
// reproducible.
const kits: Kit[] = [
  women[0], men[0],
  men[1],   women[1],
  women[2], women[3],
  men[2],   women[4],
  men[3],   men[4],
];

// Five ranks of two.
//
// Spacing used to come from each figure's animation-delay, which made the gap a
// share of the VIEWPORT while the figures are sized in rem. On a phone that put
// them roughly 16px apart with 38px shoulders — a pile-up. The pack is one
// element now and every figure sits at a rem offset inside it, so the gap
// scales with the figures instead of the screen and a phone looks like a
// desktop.
const PAIRS = 5;
const STEP = 4.6;        // rem between ranks
const FAR_LAG = 0.9;     // rem — nobody holds a perfect line
const ranks = Array.from({ length: PAIRS }, (_, i) => ({
  near: kits[i * 2],
  far: kits[i * 2 + 1],
  nearX: -i * STEP,
  farX: -i * STEP - FAR_LAG,
}));

// Out in front of the whole group, and between the two files in depth rather
// than in either of them, so it leads the column up the middle.
const GAZELLE_X = STEP * 1.15;
---
<div class="runners-band" aria-hidden="true">
  <span class="runners-ground"></span>

  <div class="runners-pack">
    {/* Far file first. */}
    {ranks.map((r) => (
      <span class="runner runner--person runner--far" style={`--x:${r.farX}rem`}>
        <RunnerFigure {...r.far} />
      </span>
    ))}

    {/* Drawn between the files: the near rank passes in front of it, the far
        rank behind, so it runs up the middle of the column. */}
    <span class="runner runner--gazelle" style={`--x:${GAZELLE_X}rem`}>
      <GazelleFigure stride={0.58} />
    </span>

    {/* Near file last, so it passes in front of everything. */}
    {ranks.map((r) => (
      <span class="runner runner--person runner--near" style={`--x:${r.nearX}rem`}>
        <RunnerFigure {...r.near} />
      </span>
    ))}
  </div>
</div>
