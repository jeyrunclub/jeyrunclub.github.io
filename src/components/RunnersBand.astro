---
// The gazelle out in front, the club strung out behind it.
//
// Every figure is a rig whose joints CSS rotates (RunnerFigure.astro and
// GazelleFigure.astro); this file only dresses them, places them and carries
// them across. Kit colours are read off the club's own photographs — the black
// tee and white shorts, the blue tee, the all-black kit — rather than invented,
// so the pack looks like a Friday morning on Farmanieh and not a stock set.
//
// Decorative, so the whole strip is aria-hidden. It also breaks the page's
// rhythm on purpose: every other section is eyebrow → heading → grid inside
// the same container, and this one is edge to edge with nothing but movement.

import RunnerFigure from './RunnerFigure.astro';
import GazelleFigure from './GazelleFigure.astro';

const pack = [
  {
    cls: 'runner--1', delay: -0.31, stride: 0.60,
    shirt: '#17130f', shorts: '#efe7d8', skin: '#c98d5e',
    hair: '#8b8075', shoe: '#f7f2e8', head: 'short' as const,
  },
  {
    cls: 'runner--2', delay: -0.08, stride: 0.66,
    shirt: '#4d7fa6', shorts: '#1d3f77', skin: '#d9a677',
    hair: '#2b2018', shoe: '#17130f', head: 'cap' as const,
  },
  {
    cls: 'runner--3', delay: -0.44, stride: 0.63,
    shirt: '#17130f', shorts: '#17130f', skin: '#e0b489',
    hair: '#17130f', shoe: '#e00a2e', head: 'ponytail' as const,
  },
];
---
<div class="runners-band" aria-hidden="true">
  <span class="runners-ground"></span>

  <span class="runner runner--gazelle">
    <GazelleFigure delay={-0.2} stride={0.58} />
  </span>

  {pack.map((p) => (
    <span class:list={['runner', 'runner--person', p.cls]}>
      <RunnerFigure
        shirt={p.shirt} shorts={p.shorts} skin={p.skin}
        hair={p.hair} shoe={p.shoe} head={p.head}
        delay={p.delay} stride={p.stride}
      />
    </span>
  ))}
</div>
