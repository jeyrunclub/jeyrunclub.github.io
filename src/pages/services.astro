---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { Image } from 'astro:assets';
import { byFile, CARD_WIDTHS, CARD_SIZES, CARD_QUALITY } from '../lib/gallery.js';

// Each service is shown with a frame from the club's own photographs rather
// than an icon alone: the page used to be five wide white cards with the text
// crammed into the right-hand third and nothing in the other two, and a club
// that has 72 photographs of itself should not be selling training in prose.
const services = [
  { id: 'private', icon: 'stopwatch', title: 'کلاس خصوصی',
    photo: 'new-img_7072.jpg',
    desc: 'تمرین یک‌به‌یک با سالار. مناسب کسانی که سریع‌ترین پیشرفت را می‌خواهند، یا هدف مسابقه‌ی خاصی دارند.',
    bullets: ['برنامه‌ی هفتگی اختصاصی', 'اصلاح تکنیک لحظه‌ای', 'تحلیل داده‌های ساعت و استراوا'] },
  { id: 'group', icon: 'group', title: 'کلاس گروهی',
    photo: 'team-group.jpg',
    desc: 'هر روز ساعت ۶ صبح در نقاط مختلف تهران و اطراف. تمرین در جمع، انگیزه‌ی مضاعف، هزینه‌ی کمتر.',
    bullets: ['کشوری، انقلاب، لواسان، درکه، قوچک، ولایت، یاس فاطمی', 'مناسب همه‌ی سطوح', 'گروه‌بندی بر اساس سرعت'] },
  { id: 'online', icon: 'screen', title: 'برنامه‌ی آنلاین',
    photo: '3.jpg',
    desc: 'اگر خارج از تهران یا خارج از ایرانی، برنامه‌ی هفتگی اختصاصی از راه دور دریافت کن.',
    bullets: ['به‌روزرسانی هفتگی', 'پشتیبانی از طریق واتساپ', 'بر اساس مسابقه‌ی هدف تو'] },
  { id: 'mountain', icon: 'peak', title: 'برنامه‌های کوهستان و دماوند',
    photo: 'new-img_6975.jpg',
    desc: 'اردوهای تریل و صعود — از تریل‌های لواسان و قوچک تا صعود قله‌ی دماوند.',
    bullets: ['اردوی ارتفاع', 'تمرین در ارتفاعات', 'مسیرهای مختلف در طول سال'] },
  { id: 'race-prep', icon: 'flag', title: 'آمادگی مسابقه',
    photo: 'new-img_8128.jpg',
    desc: 'برنامه‌ی هدفمند برای مسابقه‌ات — از اولین ۵ کیلومتر تا اولین ماراتن یا PB.',
    bullets: ['۵، ۱۰، ۲۱ و ماراتن', 'برنامه‌ی ۸ تا ۱۶ هفته‌ای', 'استراتژی روز مسابقه'] },
].map((s) => ({ ...s, frame: byFile(s.photo) }));

const band = byFile('moment-a.jpg');
---
<Base
  title="خدمات جیران — کلاس خصوصی، گروهی، آنلاین، اردوی کوهستان"
  description="خدمات باشگاه جیران: کلاس خصوصی و گروهی در تهران، برنامه‌ی آنلاین اختصاصی، اردوهای تریل و صعود دماوند، آمادگی برای مسابقات ۵ تا ماراتن."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">خدمات</p>
      <h1>خدمات جیران</h1>
      <p class="lead">
        هر دونده هدف متفاوتی دارد. برای همین ما پنج مسیر ورودی متفاوت داریم — از تمرین خصوصی
        یک‌به‌یک تا اردوی صعود دماوند.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="service-detail-grid">
        {services.map((s) => (
          <article id={s.id} class="service-detail">
            <a href={`/photo/${s.frame.id}`} class="sd-photo" aria-label={s.frame.title}>
              <Image
                src={s.frame.image}
                alt={s.frame.title}
                widths={CARD_WIDTHS}
                sizes={CARD_SIZES}
                quality={CARD_QUALITY}
                loading="lazy"
              />
            </a>
            <div class="sd-body">
              <div class="sd-icon"><Icon name={s.icon} size={26} /></div>
              <h2>{s.title}</h2>
              <p>{s.desc}</p>
              <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>
              <a href="https://wa.me/989128889975" target="_blank" rel="noopener" class="btn btn-ghost">درخواست این خدمت</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PhotoBand
    photo={band}
    quote="هر دونده یک برنامه‌ی مخصوص خودش دارد."
    by="سالار پیری"
    role="مربی و بنیان‌گذار جیران"
  />

  <section class="section join">
    <div class="container join-inner">
      <div>
        <p class="section-eyebrow">شروع</p>
        <h2>کدام مسیر مال توست؟</h2>
        <p>اگر مطمئن نیستی، بنویس چه هدفی داری و کجا تمرین می‌کنی — سالار مسیر درست را پیشنهاد می‌دهد.</p>
      </div>
      <div class="join-actions">
        <a class="btn btn-whatsapp" href="https://wa.me/989128889975" target="_blank" rel="noopener">پیام در واتساپ</a>
      </div>
    </div>
  </section>
</Base>
