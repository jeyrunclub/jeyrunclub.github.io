---
import Base from '../layouts/Base.astro';
import gallery from '../data/gallery.json';

const photos = gallery.photos.map((p, i) => ({ ...p, id: i + 1 }));
const PAGE_SIZE = 24;
const firstPage = photos.slice(0, PAGE_SIZE);
const fa = (n) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);
---
<Base
  title="گالری جیران — عکس‌های تمرین، مسابقه و کوهستان"
  description="گالری تصاویر باشگاه جیران — لحظات تمرین، مسابقات، اردوهای کوهستان و صعودها."
  ogImage="/images/gallery/new-img_3475.jpg"
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">گالری</p>
      <h1>لحظه‌های جیران</h1>
      <p class="lead">
        {fa(photos.length)} عکس از تمرین، مسابقه، اردوهای کوهستان و لحظات صمیمی تیم. روی هر عکس بزن تا داستانش را ببینی.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery-grid" id="gallery-grid" data-page-size={PAGE_SIZE}>
        {firstPage.map((p) => (
          <a href={`/photo/${p.id}`} class="gal-item">
            <span class="gal-badge">#{fa(p.id)}</span>
            <img src={`/images/gallery/${p.file}`} alt={p.title || `عکس شماره ${p.id}`} loading="lazy" />
            <span class="gal-caption">
              {p.title && <strong>{p.title}</strong>}
              {p.story && <span>{p.story}</span>}
            </span>
          </a>
        ))}
      </div>

      {photos.length > PAGE_SIZE && (
        <div class="load-more-wrap">
          <button id="load-more" class="btn btn-ghost" type="button">
            نمایش عکس‌های بیشتر ({fa(photos.length - PAGE_SIZE)} باقی‌مانده)
          </button>
        </div>
      )}
    </div>
  </section>

  <script define:vars={{ photos, PAGE_SIZE }}>
    const btn = document.getElementById('load-more');
    const grid = document.getElementById('gallery-grid');
    const fa = (n) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);
    let shown = PAGE_SIZE;
    btn?.addEventListener('click', () => {
      const next = photos.slice(shown, shown + PAGE_SIZE);
      const html = next.map((p) => `
        <a href="/photo/${p.id}" class="gal-item">
          <span class="gal-badge">#${fa(p.id)}</span>
          <img src="/images/gallery/${p.file}" alt="${p.title || 'عکس شماره ' + p.id}" loading="lazy" />
          <span class="gal-caption">
            ${p.title ? `<strong>${p.title}</strong>` : ''}
            ${p.story ? `<span>${p.story}</span>` : ''}
          </span>
        </a>`).join('');
      grid.insertAdjacentHTML('beforeend', html);
      shown += PAGE_SIZE;
      if (shown >= photos.length) {
        btn.remove();
      } else {
        btn.textContent = `نمایش عکس‌های بیشتر (${fa(photos.length - shown)} باقی‌مانده)`;
      }
    });
  </script>
</Base>
