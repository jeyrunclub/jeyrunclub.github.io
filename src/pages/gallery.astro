---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { photos, THUMB_WIDTHS, THUMB_QUALITY, GRID_SIZES } from '../lib/gallery.js';

const PAGE_SIZE = 24;
const firstPage = photos.slice(0, PAGE_SIZE);
const fa = (n) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);

// The load-more button builds its markup in the browser, so the optimised URLs
// have to be worked out here and handed over — otherwise everything past the
// first page would quietly fall back to the unprocessed original.
const rest = await Promise.all(
  photos.slice(PAGE_SIZE).map(async (p) => {
    const [small, large] = await Promise.all(
      THUMB_WIDTHS.map((w) => getImage({ src: p.image, width: w, format: 'webp', quality: THUMB_QUALITY })),
    );
    return {
      id: p.id,
      title: p.title,
      story: p.story,
      shape: p.shape,
      src: large.src,
      srcset: `${small.src} ${THUMB_WIDTHS[0]}w, ${large.src} ${THUMB_WIDTHS[1]}w`,
      w: p.image.width,
      h: p.image.height,
    };
  }),
);
---
<Base
  title="گالری جیران — عکس‌های تمرین، مسابقه و کوهستان"
  description="گالری تصاویر باشگاه جیران — لحظات تمرین، مسابقات، اردوهای کوهستان و صعودها."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">گالری</p>
      <h1>لحظه‌های جیران</h1>
      <p class="lead">
        {fa(photos.length)} عکس از تمرین، مسابقه، اردوهای کوهستان و لحظات صمیمی تیم. روی هر عکس بزن تا داستانش را ببینی.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery-grid" id="gallery-grid" data-page-size={PAGE_SIZE}>
        {firstPage.map((p) => (
          <a href={`/photo/${p.id}`} class={`gal-item is-${p.shape}`}>
            <span class="gal-badge">#{fa(p.id)}</span>
            <Image
              src={p.image}
              alt={p.title || `عکس شماره ${p.id}`}
              widths={THUMB_WIDTHS}
              sizes={GRID_SIZES}
              quality={THUMB_QUALITY}
              loading="lazy"
            />
            <span class="gal-caption">
              {p.title && <strong>{p.title}</strong>}
              {p.story && <span>{p.story}</span>}
            </span>
          </a>
        ))}
      </div>

      {photos.length > PAGE_SIZE && (
        <div class="load-more-wrap">
          <button id="load-more" class="btn btn-ghost" type="button">
            نمایش عکس‌های بیشتر ({fa(photos.length - PAGE_SIZE)} باقی‌مانده)
          </button>
        </div>
      )}
    </div>
  </section>

  <script define:vars={{ rest, PAGE_SIZE, total: photos.length }}>
    const btn = document.getElementById('load-more');
    const grid = document.getElementById('gallery-grid');
    const fa = (n) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);
    const SIZES = '(max-width: 640px) 92vw, (max-width: 1100px) 45vw, 290px';
    let shown = PAGE_SIZE;
    btn?.addEventListener('click', () => {
      const next = rest.slice(shown - PAGE_SIZE, shown - PAGE_SIZE + PAGE_SIZE);
      const html = next.map((p) => `
        <a href="/photo/${p.id}" class="gal-item is-${p.shape}">
          <span class="gal-badge">#${fa(p.id)}</span>
          <img src="${p.src}" srcset="${p.srcset}" sizes="${SIZES}"
               width="${p.w}" height="${p.h}"
               alt="${p.title || 'عکس شماره ' + p.id}" loading="lazy" decoding="async" />
          <span class="gal-caption">
            ${p.title ? `<strong>${p.title}</strong>` : ''}
            ${p.story ? `<span>${p.story}</span>` : ''}
          </span>
        </a>`).join('');
      grid.insertAdjacentHTML('beforeend', html);
      shown += PAGE_SIZE;
      if (shown >= total) {
        btn.remove();
      } else {
        btn.textContent = `نمایش عکس‌های بیشتر (${fa(total - shown)} باقی‌مانده)`;
      }
    });
  </script>
</Base>
