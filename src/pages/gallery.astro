---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { ordered, THUMB_WIDTHS, THUMB_QUALITY, GRID_SIZES } from '../lib/gallery.js';

// Every photo, in one masonry, group shots first.
//
// This used to render 24 and append the rest on a button. In a column
// masonry an append is the one thing you cannot do quietly: the columns
// rebalance, so the photographs already on screen jump to new positions and
// the new ones land wherever the balancing puts them rather than at the
// bottom. Rendering the lot removes the problem rather than managing it —
// and costs nothing, because every image below the fold is lazy.
const photos = ordered;
---
<Base
  title="گالری جیران — عکس‌های تمرین، مسابقه و کوهستان"
  description="گالری تصاویر باشگاه جیران — لحظات تمرین، مسابقات، اردوهای کوهستان و صعودها."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">گالری</p>
      <h1>لحظه‌های جیران</h1>
      <p class="lead">
        عکس‌هایی از تمرین، مسابقه، اردوهای کوهستان و لحظات صمیمی تیم. روی هر عکس بزن تا داستانش را ببینی.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery-grid">
        {photos.map((p, i) => (
          <a href={`/photo/${p.id}`} class="gal-item">
            <Image
              src={p.image}
              alt={p.title || 'عکسی از گالری جیران'}
              widths={THUMB_WIDTHS}
              sizes={GRID_SIZES}
              quality={THUMB_QUALITY}
              loading={i < 8 ? 'eager' : 'lazy'}
            />
            <span class="gal-caption">
              {p.title && <strong>{p.title}</strong>}
              {p.story && <span>{p.story}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
