---
import Base from '../../layouts/Base.astro';
import { ClientRouter } from 'astro:transitions';
import { Image, getImage } from 'astro:assets';
import { photos, ordered, FULL_WIDTHS, FULL_QUALITY, CARD_WIDTH, CARD_QUALITY } from '../../lib/gallery.js';

export function getStaticPaths() {
  // One page per photo, keyed by photo.id — the id comes from the position in
  // `photos`, not from `ordered`, so these URLs stay put however the gallery
  // chooses to arrange itself.
  //
  // Prev and next, though, walk `ordered`: stepping through has to match the
  // sequence you just saw in the grid, or the next photo is one you have no
  // reason to expect. Position is counted in that same order.
  return photos.map((photo) => {
    const i = ordered.findIndex((p) => p.id === photo.id);
    return {
      params: { id: String(photo.id) },
      props: {
        photo,
        position: i + 1,
        prev: i > 0 ? ordered[i - 1].id : null,
        next: i < ordered.length - 1 ? ordered[i + 1].id : null,
        total: ordered.length,
      },
    };
  });
}

const { photo, position, prev, next, total } = Astro.props;
const fa = (n) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);

// Each photo gets its own social card, as a JPEG for crawler compatibility.
const card = await getImage({ src: photo.image, format: 'jpeg', width: CARD_WIDTH, quality: CARD_QUALITY });
---
<Base
  title={`${photo.title || 'گالری جیران'} — عکس‌های جیران`}
  description={photo.story || photo.title || 'عکسی از گالری باشگاه جیران'}
  ogImage={card.src}
>
  {/* Only the photo pages opt into the client router, so stepping from one
      frame to the next swaps the page in place instead of reloading the whole
      document. Leaving the gallery, or any other page, is still an ordinary
      navigation — Astro falls back to one automatically. */}
  <ClientRouter slot="head" />

  <section class="photo-page">
    <div class="container photo-inner">
      <p class="photo-crumb">
        <a href="/gallery">← بازگشت به گالری</a>
      </p>

      <figure class="photo-hero" transition:name="photo-stage" transition:animate="fade">
        <Image
          src={photo.image}
          alt={photo.title || `عکس شماره ${position}`}
          widths={FULL_WIDTHS}
          sizes="(max-width: 900px) 94vw, 860px"
          quality={FULL_QUALITY}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="photo-meta">
        {photo.title && <h1>{photo.title}</h1>}
        {photo.story ? (
          <p class="photo-story">{photo.story}</p>
        ) : (
          <p class="photo-story photo-story-empty">
            هنوز داستانی برای این عکس نوشته نشده.
            <br />
            <em>اگر می‌خواهی داستان این لحظه را ثبت کنی، به سالار بگو کدام عکس است.</em>
          </p>
        )}
      </div>

      {/* data-astro-prefetch: the next frame is fetched while this one is on
          screen, so stepping through the gallery does not wait on the network
          each time. data-photo-prev/next are what the key handler below reads. */}
      <nav class="photo-nav">
        {prev ? (
          <a href={`/photo/${prev}`} class="btn btn-ghost" data-photo-prev data-astro-prefetch="viewport">→ قبلی</a>
        ) : <span></span>}
        <a href="/gallery" class="btn btn-ghost">همه‌ی عکس‌ها</a>
        {next ? (
          <a href={`/photo/${next}`} class="btn btn-ghost" data-photo-next data-astro-prefetch="viewport">بعدی ←</a>
        ) : <span></span>}
      </nav>

      <p class="photo-keyhint">
        <span class="hint-keys">با کلیدهای <kbd>←</kbd> و <kbd>→</kbd> هم می‌توانی عکس‌ها را ورق بزنی.</span>
        <span class="hint-swipe">انگشتت را روی عکس بکش تا عکس بعدی بیاید.</span>
      </p>
    </div>
  </section>

  <script>
    // Stepping through the gallery, by key or by thumb.
    //
    // Both listeners live on `document`, which survives a view transition, and
    // both look the links up fresh each time — so this registers once and
    // keeps working however many photos you walk through. The guard is there
    // because a bundled module can be re-evaluated, and two listeners would
    // skip two photos per gesture.
    import { navigate } from 'astro:transitions/client';

    if (!window.__jeyrunPhotoNav) {
      window.__jeyrunPhotoNav = true;

      const rtl = () => document.documentElement.dir === 'rtl';
      const go = (which) => {
        const a = document.querySelector(`[data-photo-${which}]`);
        if (a instanceof HTMLAnchorElement) navigate(a.href);
      };

      // Keys follow reading order rather than the key's name: Persian runs
      // right to left, so Left is forwards here and backwards in English.
      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        const t = e.target;
        if (t instanceof HTMLElement &&
            (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(rtl() ? 'next' : 'prev'); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); go(rtl() ? 'prev' : 'next'); }
      });

      // Swipe. The next photo sits on the side its button's arrow points to —
      // left in Persian, right in English — so the gesture that brings it in
      // is a drag the other way. Vertical movement is let through so the
      // gesture never fights an ordinary scroll.
      let x0 = null, y0 = null;
      document.addEventListener('touchstart', (e) => {
        if (!e.target || !(e.target instanceof Element)) return;
        if (!e.target.closest('.photo-hero')) { x0 = null; return; }
        x0 = e.changedTouches[0].clientX;
        y0 = e.changedTouches[0].clientY;
      }, { passive: true });

      document.addEventListener('touchend', (e) => {
        if (x0 === null) return;
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        x0 = null;
        if (Math.abs(dx) < 45 || Math.abs(dy) > Math.abs(dx)) return;
        go((rtl() ? dx > 0 : dx < 0) ? 'next' : 'prev');
      }, { passive: true });
    }
  </script>
</Base>
