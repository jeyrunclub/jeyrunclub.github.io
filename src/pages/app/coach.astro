---
import AppShell from '../../layouts/AppShell.astro';
---
<AppShell title="پنل مربی">
  <div id="loading" class="app-empty"><div class="app-spinner"></div></div>
  <div id="denied" class="app-empty" hidden><h3>دسترسی ندارد</h3><p>این صفحه فقط برای مربی است.</p></div>

  <section id="content" hidden>
    <div class="page-hero">
      <div>
        <h1 class="page-title">پنل مربی</h1>
        <p class="page-subtitle" id="hero-sub">در حال بارگذاری…</p>
      </div>
      <div class="stats">
        <div class="stat-pill"><span class="n accent" id="stat-pending">۰</span><span class="l">درخواست</span></div>
        <div class="stat-pill"><span class="n" id="stat-students">۰</span><span class="l">شاگرد</span></div>
        <div class="stat-pill"><span class="n" id="stat-sessions">۰</span><span class="l">جلسه‌ی ماه</span></div>
      </div>
    </div>

    <!-- STUDENT PICKER -->
    <div class="list-card" style="padding:16px 22px;">
      <label class="app-label" for="student-picker">شاگرد فعال</label>
      <select id="student-picker" class="app-select"></select>
      <p id="picker-hint" style="margin:10px 0 0;color:var(--muted);font-size:0.82rem;">
        شاگرد را انتخاب کن، سپس روی روزی از تقویم بزن.
      </p>
    </div>

    <!-- PENDING APPROVAL REQUESTS -->
    <div id="pending-block" class="list-card" hidden>
      <h2>درخواست‌های در انتظار</h2>
      <div id="pending-list"></div>
    </div>

    <!-- CALENDAR -->
    <div class="cal-card">
      <div class="cal-header">
        <button class="arrow" id="cal-prev" aria-label="ماه قبل">‹</button>
        <div>
          <div class="cal-month" id="cal-month"></div>
          <div class="cal-year" id="cal-year"></div>
        </div>
        <button class="arrow" id="cal-next" aria-label="ماه بعد">›</button>
      </div>
      <div class="cal-dow-row">
        <span>شنبه</span><span>یک‌شنبه</span><span>دوشنبه</span><span>سه‌شنبه</span>
        <span>چهارشنبه</span><span>پنج‌شنبه</span><span>جمعه</span>
      </div>
      <div class="cal-grid" id="cal-grid"></div>
    </div>

    <!-- ALL STUDENTS LIST -->
    <div class="list-card">
      <h2>همه شاگردان</h2>
      <div id="student-list"></div>
    </div>
  </section>

  <!-- SESSION EDITOR MODAL -->
  <div id="editor" class="modal-overlay" hidden>
    <div class="modal-panel" role="dialog" aria-labelledby="editor-title">
      <div class="modal-head">
        <div>
          <h2 id="editor-title" class="modal-h">جلسه‌ی جدید</h2>
          <p id="editor-sub" class="modal-sub"></p>
        </div>
        <button type="button" id="editor-close" class="icon-btn" aria-label="بستن">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <label class="app-label">نوع تمرین</label>
      <div class="type-chips" id="type-chips"></div>

      <div class="field" style="margin-top:16px;">
        <label class="app-label" for="editor-title-input">عنوان (اختیاری)</label>
        <input id="editor-title-input" class="app-input" placeholder="مثلاً: تمپو ۵×۱km" />
      </div>

      <label class="app-label" style="margin-top:6px;">مراحل تمرین</label>
      <div id="blocks-list"></div>

      <div class="add-block-row">
        <button type="button" class="app-btn ghost sm add-blk" data-kind="warmup">+ گرم‌کردن</button>
        <button type="button" class="app-btn ghost sm add-blk" data-kind="run">+ دو</button>
        <button type="button" class="app-btn ghost sm add-blk" data-kind="interval">+ اینتروال</button>
        <button type="button" class="app-btn ghost sm add-blk" data-kind="cooldown">+ سردکردن</button>
        <button type="button" class="app-btn ghost sm add-blk" data-kind="rest">+ استراحت</button>
        <button type="button" class="app-btn ghost sm add-blk" data-kind="note">+ یادداشت</button>
      </div>

      <div class="field" style="margin-top:16px;">
        <label class="app-label" for="editor-notes">یادداشت برای شاگرد (اختیاری)</label>
        <textarea id="editor-notes" class="app-textarea" placeholder="نکته‌های اضافی…"></textarea>
      </div>

      <div id="submitted-panel" class="submitted-panel" hidden>
        <div class="submitted-head">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <span>شاگرد این جلسه را انجام‌شده اعلام کرده</span>
        </div>
        <div id="submitted-note-wrap" hidden style="margin-top:10px;">
          <div class="app-label">یادداشت شاگرد</div>
          <div id="submitted-note" class="app-msg info" style="margin-top:4px;"></div>
        </div>
        <div id="submitted-photo-wrap" hidden style="margin-top:10px;">
          <div class="app-label">عکس شاگرد</div>
          <a id="submitted-photo-link" target="_blank" rel="noopener">
            <img id="submitted-photo" alt="عکس تمرین" />
          </a>
        </div>
        <div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;">
          <button type="button" id="submitted-approve" class="app-btn sm">تأیید انجام</button>
          <button type="button" id="submitted-reject" class="app-btn ghost sm">رد</button>
        </div>
      </div>

      <div id="editor-msg"></div>

      <div class="modal-actions">
        <button type="button" id="editor-delete" class="app-btn ghost" style="margin-inline-end:auto;color:#e05656;border-color:rgba(200,60,60,0.4);" hidden>حذف جلسه</button>
        <button type="button" id="editor-cancel" class="app-btn ghost">لغو</button>
        <button type="button" id="editor-save" class="app-btn">ذخیره</button>
      </div>
    </div>
  </div>

  <style>
    .modal-overlay[hidden] { display: none !important; }
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.55);
      backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center;
      padding: 16px; z-index: 100;
      overflow-y: auto;
      animation: fadeIn .2s ease-out;
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .modal-panel {
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 24px;
      width: 100%; max-width: 620px;
      max-height: 92vh; overflow-y: auto;
      box-shadow: var(--app-shadow-lg);
      animation: slideUp .25s ease-out;
    }
    @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .modal-head {
      display:flex; align-items:flex-start; justify-content:space-between;
      gap: 12px; margin-bottom: 20px;
    }
    .modal-h { margin: 0; font-size: 1.25rem; font-weight: 700; }
    .modal-sub { margin: 4px 0 0; color: var(--muted); font-size: 0.88rem; }
    .icon-btn {
      width: 36px; height: 36px; background: transparent;
      border: 1px solid var(--border); color: var(--text-dim);
      border-radius: 999px; cursor: pointer;
      display:inline-flex; align-items:center; justify-content:center;
      transition: all .15s;
    }
    .icon-btn:hover { color: var(--accent); border-color: var(--accent); }
    .modal-actions {
      display:flex; gap:10px; margin-top: 22px; align-items: center;
    }

    .type-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .type-chip {
      padding: 8px 14px; border-radius: 999px;
      background: var(--surface); border: 1.5px solid var(--border);
      color: var(--text-dim); font-family: inherit; font-size: 0.88rem;
      font-weight: 600; cursor: pointer;
      transition: all .15s;
    }
    .type-chip:hover { border-color: var(--border-strong); color: var(--text); }
    .type-chip.active {
      background: var(--app-accent-soft);
      border-color: var(--accent);
      color: var(--accent);
    }

    .block-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
      margin-bottom: 8px;
      position: relative;
    }
    .block-item .blk-head {
      display:flex; align-items:center; justify-content:space-between;
      margin-bottom: 8px;
    }
    .block-item .blk-name {
      font-weight: 700; font-size: 0.92rem;
    }
    .block-item .blk-del {
      background: transparent; border: none; color: var(--muted);
      font-family: inherit; font-size: 1.1rem; cursor: pointer;
      width: 28px; height: 28px; border-radius: 999px;
      display:inline-flex; align-items:center; justify-content:center;
    }
    .block-item .blk-del:hover { color: #e05656; background: rgba(200,60,60,0.1); }
    .blk-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 8px; }
    .blk-fields .desc { grid-column: 1 / -1; }
    .blk-input {
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-family: inherit; font-size: 0.88rem;
      width: 100%; box-sizing: border-box;
    }
    .blk-input:focus {
      outline: none; border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--app-accent-soft);
    }
    .blk-input::placeholder { color: var(--muted); font-size: 0.82rem; }
    .add-block-row {
      display:flex; flex-wrap: wrap; gap: 6px; margin: 6px 0 0;
    }
    .add-block-row .app-btn { padding: 6px 12px; font-size: 0.82rem; }

    /* Calendar */
    .cal-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--app-radius-lg);
      padding: 18px;
      box-shadow: var(--app-shadow-sm);
      margin-bottom: 18px;
    }
    .cal-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 12px;
    }
    .cal-header .arrow {
      width: 38px; height: 38px; background: transparent; border: none;
      color: var(--text-dim); font-size: 1.4rem; cursor: pointer;
      border-radius: 999px; transition: all .15s; font-family: inherit;
    }
    .cal-header .arrow:hover { background: var(--app-accent-soft); color: var(--accent); }
    .cal-header > div { text-align: center; }
    .cal-month { font-size: 1.15rem; font-weight: 700; }
    .cal-year { font-size: 0.82rem; color: var(--muted); margin-top: 2px; }
    .cal-dow-row {
      display: grid; grid-template-columns: repeat(7, 1fr);
      gap: 4px; margin-bottom: 6px;
      font-size: 0.72rem; color: var(--muted); text-align: center;
      font-weight: 600;
    }
    .cal-dow-row span { padding: 6px 0; }
    .cal-grid {
      display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;
    }
    .cal-cell {
      min-height: 72px;
      background: var(--surface-2);
      border: 1px solid transparent;
      border-radius: 10px;
      padding: 6px;
      cursor: pointer;
      display: flex; flex-direction: column;
      transition: background .12s, border-color .12s, transform .1s;
      position: relative;
    }
    .cal-cell:hover { background: var(--app-accent-soft); border-color: var(--accent); }
    .cal-cell.out { opacity: 0.35; cursor: default; }
    .cal-cell.out:hover { background: var(--surface-2); border-color: transparent; }
    .cal-cell.today {
      background: var(--app-accent-soft);
      border-color: var(--accent);
    }
    .cal-cell .num { font-weight: 700; font-size: 0.88rem; text-align: start; margin-bottom: 4px; }
    .cal-cell .num-sec { color: var(--muted); font-size: 0.68rem; font-weight: 400; }
    .cal-cell .pills { display: flex; flex-direction: column; gap: 2px; }
    .cal-pill {
      background: var(--surface);
      border-radius: 6px;
      padding: 2px 6px;
      font-size: 0.68rem;
      color: var(--text);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      border-inline-start: 3px solid;
      line-height: 1.3;
    }
    .cal-pill.status-submitted { background: rgba(230,162,60,0.12); }
    .cal-pill.status-done { background: rgba(60,160,90,0.15); }
    @media (max-width: 560px) {
      .cal-cell { min-height: 58px; padding: 4px; }
      .cal-cell .num { font-size: 0.78rem; margin-bottom: 2px; }
      .cal-pill { font-size: 0.6rem; padding: 1px 4px; }
    }

    /* Submitted-claim panel */
    .submitted-panel {
      margin-top: 18px;
      padding: 16px;
      border-radius: 14px;
      background: rgba(230,162,60,0.08);
      border: 1px solid rgba(230,162,60,0.28);
    }
    .submitted-panel .submitted-head {
      display: flex; align-items: center; gap: 8px;
      color: #c8963e; font-weight: 700; font-size: 0.95rem;
    }
    .submitted-panel img {
      max-width: 100%; max-height: 260px; border-radius: 10px;
      border: 1px solid var(--border); display: block; margin-top: 4px;
      cursor: zoom-in;
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import {
      TYPES, TYPE_BY_ID, BLOCK_KIND_BY_ID, MONTHS_FA_GREG,
      isoDate, addDays, weekSaturdayOf, today, faNum, faDateLong, faDateShort,
      monthGrid, fetchSessionsForRange, loadOrInitPlan, savePlan,
      summariseSession, newSession, newBlock,
      signedPhotoUrl,
    } from '../../lib/plan.js';

    let coachId = null;
    let allUsers = [];
    let currentStudentId = null;
    let calYear, calMonth;             // Gregorian
    let sessionsByStudent = {};        // sid -> { date -> [session] }
    let editing = null;                // { studentId, dateIso, session, isNew }

    // ---------- Header setup ----------
    function setupHeader() {
      const nav = document.getElementById('app-nav');
      nav.hidden = false;
      document.getElementById('coach-link').hidden = false;
      document.getElementById('signout-btn').addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.replace('/app/login');
      });
    }

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
      }[c]));
    }

    // ---------- Users list ----------
    async function fetchAllUsers() {
      const { data } = await supabase.rpc('list_all_users');
      allUsers = data || [];
    }

    function renderStudentPicker() {
      const students = allUsers.filter((u) => u.status === 'approved' && u.role !== 'coach');
      const picker = document.getElementById('student-picker');
      picker.innerHTML = students.length
        ? students.map((s) => `<option value="${s.id}">${esc(s.full_name || s.email)}</option>`).join('')
        : '<option value="" disabled>هیچ شاگردی هنوز تأیید نشده</option>';
      if (students.length) {
        if (!currentStudentId || !students.find((s) => s.id === currentStudentId)) {
          currentStudentId = students[0].id;
        }
        picker.value = currentStudentId;
      } else {
        currentStudentId = null;
      }
    }

    function renderPending() {
      const rows = allUsers.filter((u) => u.status === 'pending');
      const block = document.getElementById('pending-block');
      const list  = document.getElementById('pending-list');
      block.hidden = !rows.length;
      if (!rows.length) return;
      list.innerHTML = rows.map((r) => `
        <div class="student-row">
          <div class="avatar">${esc((r.full_name || r.email || '?')[0])}</div>
          <div class="grow">
            <div class="name">${esc(r.full_name || '(بدون نام)')}</div>
            <div class="meta" dir="ltr">${esc(r.email || '')}${r.phone ? ' · ' + esc(r.phone) : ''}</div>
          </div>
          <div class="actions">
            <button class="app-btn sm" data-id="${r.id}" data-act="approve">تأیید</button>
            <button class="app-btn ghost sm" data-id="${r.id}" data-act="reject">رد</button>
          </div>
        </div>
      `).join('');
      list.querySelectorAll('button[data-act]').forEach((b) => {
        b.addEventListener('click', async () => {
          const id = b.dataset.id;
          const status = b.dataset.act === 'approve' ? 'approved' : 'rejected';
          const { error } = await supabase.rpc('set_profile_status',
            { target: id, new_status: status, new_role: null });
          if (error) { alert(error.message); return; }
          await refresh();
        });
      });
    }

    function renderStudentsList() {
      const rows = allUsers.filter((u) => u.status !== 'pending');
      const list = document.getElementById('student-list');
      if (!rows.length) {
        list.innerHTML = '<p style="padding:16px 0;color:var(--muted);">هنوز شاگردی نیست.</p>';
        return;
      }
      list.innerHTML = rows.map((r) => {
        const per = sessionsByStudent[r.id] || {};
        const total = Object.values(per).reduce((n, arr) => n + arr.length, 0);
        const submitted = Object.values(per).flat().filter((s) => s.status === 'submitted').length;
        return `
        <div class="student-row" data-id="${r.id}">
          <div class="avatar ${r.role === 'coach' ? 'muted' : ''}">${esc((r.full_name || r.email || '?')[0])}</div>
          <div class="grow">
            <div class="name">
              ${esc(r.full_name || '(بدون نام)')}
              ${r.role === 'coach' ? '<span class="badge coach">مربی</span>' : ''}
              ${r.status === 'rejected' ? '<span class="badge rejected">رد شده</span>' : ''}
              ${submitted ? `<span class="badge pending">${faNum(submitted)} تیک منتظر تأیید</span>` : ''}
            </div>
            <div class="meta" dir="ltr">${esc(r.email || '')}${r.phone ? ' · ' + esc(r.phone) : ''}</div>
          </div>
          <div class="actions">
            ${r.role === 'coach' ? '' : `<button class="app-btn ghost sm" data-select="${r.id}">این ماه: ${faNum(total)}</button>`}
          </div>
        </div>`;
      }).join('');
      list.querySelectorAll('button[data-select]').forEach((b) => {
        b.addEventListener('click', () => {
          currentStudentId = b.dataset.select;
          document.getElementById('student-picker').value = currentStudentId;
          renderCalendar();
          document.querySelector('.cal-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    }

    // ---------- Calendar ----------
    function initCalendar() {
      const now = new Date();
      calYear = now.getFullYear();
      calMonth = now.getMonth();
      document.getElementById('cal-prev').addEventListener('click', () => {
        calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
        refreshCalendar();
      });
      document.getElementById('cal-next').addEventListener('click', () => {
        calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
        refreshCalendar();
      });
    }

    async function refreshCalendar() {
      const cells = monthGrid(calYear, calMonth);
      const from = cells[0].date, to = cells[cells.length - 1].date;
      const sids = allUsers.filter((u) => u.status === 'approved' && u.role !== 'coach').map((u) => u.id);
      sessionsByStudent = await fetchSessionsForRange(supabase, sids, from, to);
      renderCalendar(cells);
      // stats
      const sessCount = Object.values(sessionsByStudent).reduce(
        (n, per) => n + Object.values(per).reduce((m, arr) => m + arr.length, 0), 0);
      document.getElementById('stat-sessions').textContent = faNum(sessCount);
      document.getElementById('stat-students').textContent = faNum(sids.length);
      document.getElementById('stat-pending').textContent =
        faNum(allUsers.filter((u) => u.status === 'pending').length);
      renderStudentsList();
    }

    function renderCalendar(cellsInput) {
      const cells = cellsInput || monthGrid(calYear, calMonth);
      document.getElementById('cal-month').textContent = MONTHS_FA_GREG[calMonth];
      document.getElementById('cal-year').textContent = calYear;
      const grid = document.getElementById('cal-grid');
      const per = currentStudentId ? (sessionsByStudent[currentStudentId] || {}) : {};

      grid.innerHTML = cells.map((c) => {
        const sessions = per[c.date] || [];
        const pills = sessions.map((s) => {
          const t = TYPE_BY_ID[s.type] || TYPE_BY_ID.easy;
          const statusClass = s.status === 'done' ? 'status-done'
                            : s.status === 'submitted' ? 'status-submitted' : '';
          return `<div class="cal-pill ${statusClass}" style="border-color:${t.color}">${esc(summariseSession(s))}</div>`;
        }).join('');
        const outCls = c.inMonth ? '' : ' out';
        const todayCls = c.isToday ? ' today' : '';
        return `<div class="cal-cell${outCls}${todayCls}" data-date="${c.date}">
          <div class="num">${faNum(c.day)}${c.isToday ? ' <span class="num-sec">امروز</span>' : ''}</div>
          <div class="pills">${pills}</div>
        </div>`;
      }).join('');

      grid.querySelectorAll('.cal-cell').forEach((el) => {
        if (el.classList.contains('out')) return;
        el.addEventListener('click', () => {
          const dateIso = el.dataset.date;
          const list = per[dateIso] || [];
          openEditor(dateIso, list[0] || null);
        });
      });
    }

    // ---------- Editor ----------
    function renderTypeChips(activeId) {
      const box = document.getElementById('type-chips');
      box.innerHTML = TYPES.map((t) => `
        <button type="button" class="type-chip${t.id === activeId ? ' active' : ''}" data-t="${t.id}">
          ${esc(t.label)}
        </button>
      `).join('');
      box.querySelectorAll('.type-chip').forEach((b) => {
        b.addEventListener('click', () => {
          editing.session.type = b.dataset.t;
          renderTypeChips(editing.session.type);
        });
      });
    }

    function renderBlocks() {
      const box = document.getElementById('blocks-list');
      const blocks = editing.session.blocks || [];
      box.innerHTML = blocks.map((b, i) => {
        const name = BLOCK_KIND_BY_ID[b.kind]?.label ?? b.kind;
        let fields = '';
        if (b.kind === 'interval') {
          fields = `
            <input class="blk-input" type="number" min="1" placeholder="تکرار" data-f="repeat" data-i="${i}" value="${b.repeat ?? ''}" />
            <input class="blk-input" type="number" step="1" min="0" placeholder="متر" data-f="distance_m" data-i="${i}" value="${b.distance_m ?? ''}" />
            <input class="blk-input" type="number" step="0.1" min="0" placeholder="کیلومتر" data-f="distance_km" data-i="${i}" value="${b.distance_km ?? ''}" />
            <input class="blk-input" type="number" step="1" min="0" placeholder="دقیقه" data-f="minutes" data-i="${i}" value="${b.minutes ?? ''}" />
            <input class="blk-input" type="number" step="1" min="0" placeholder="ثانیه استراحت" data-f="rest_sec" data-i="${i}" value="${b.rest_sec ?? ''}" />
            <input class="blk-input desc" type="text" placeholder="توضیحات (اختیاری)" data-f="description" data-i="${i}" value="${esc(b.description || '')}" />
          `;
        } else if (b.kind === 'rest') {
          fields = `
            <input class="blk-input" type="number" step="1" min="0" placeholder="دقیقه" data-f="minutes" data-i="${i}" value="${b.minutes ?? ''}" />
            <input class="blk-input desc" type="text" placeholder="توضیحات" data-f="description" data-i="${i}" value="${esc(b.description || '')}" />
          `;
        } else if (b.kind === 'note') {
          fields = `
            <input class="blk-input desc" type="text" placeholder="یادداشت" data-f="description" data-i="${i}" value="${esc(b.description || '')}" />
          `;
        } else {
          // warmup / run / cooldown
          fields = `
            <input class="blk-input" type="number" step="0.1" min="0" placeholder="کیلومتر" data-f="distance_km" data-i="${i}" value="${b.distance_km ?? ''}" />
            <input class="blk-input" type="number" step="1" min="0" placeholder="دقیقه" data-f="minutes" data-i="${i}" value="${b.minutes ?? ''}" />
            ${b.kind === 'run' ? `<input class="blk-input" type="text" placeholder="ریتم (مثلاً 5:00)" data-f="pace" data-i="${i}" value="${esc(b.pace || '')}" />` : ''}
            <input class="blk-input desc" type="text" placeholder="توضیحات (اختیاری)" data-f="description" data-i="${i}" value="${esc(b.description || '')}" />
          `;
        }
        return `
          <div class="block-item">
            <div class="blk-head">
              <span class="blk-name">${esc(name)}</span>
              <button type="button" class="blk-del" data-del="${i}" aria-label="حذف">×</button>
            </div>
            <div class="blk-fields">${fields}</div>
          </div>
        `;
      }).join('');

      box.querySelectorAll('button[data-del]').forEach((b) => {
        b.addEventListener('click', () => {
          const i = Number(b.dataset.del);
          editing.session.blocks.splice(i, 1);
          renderBlocks();
        });
      });
      box.querySelectorAll('.blk-input').forEach((el) => {
        el.addEventListener('input', () => {
          const i = Number(el.dataset.i);
          const f = el.dataset.f;
          const val = el.value.trim();
          const blk = editing.session.blocks[i];
          if (val === '') {
            delete blk[f];
          } else if (['repeat','distance_km','distance_m','minutes','rest_sec','rest_min'].includes(f)) {
            blk[f] = Number(val);
          } else {
            blk[f] = val;
          }
        });
      });
    }

    async function openEditor(dateIso, existing) {
      if (!currentStudentId) { alert('اول یک شاگرد را از بالای صفحه انتخاب کن.'); return; }
      const session = existing ? JSON.parse(JSON.stringify(existing)) : newSession(dateIso);
      editing = { studentId: currentStudentId, dateIso, session, isNew: !existing };

      document.getElementById('editor-title').textContent = existing ? 'ویرایش جلسه' : 'جلسه‌ی جدید';
      document.getElementById('editor-sub').textContent = faDateLong(dateIso);
      document.getElementById('editor-title-input').value = session.title || '';
      document.getElementById('editor-notes').value = session.notes || '';
      document.getElementById('editor-msg').innerHTML = '';
      document.getElementById('editor-delete').hidden = !existing;

      renderTypeChips(session.type);
      renderBlocks();

      // Submitted panel: show note + photo, wire approve/reject
      const panel = document.getElementById('submitted-panel');
      const noteWrap = document.getElementById('submitted-note-wrap');
      const photoWrap = document.getElementById('submitted-photo-wrap');
      if (session.status === 'submitted') {
        panel.hidden = false;
        if (session.student_note) {
          document.getElementById('submitted-note').textContent = session.student_note;
          noteWrap.hidden = false;
        } else noteWrap.hidden = true;
        if (session.student_photo_path) {
          const url = await signedPhotoUrl(supabase, session.student_photo_path);
          if (url) {
            document.getElementById('submitted-photo').src = url;
            document.getElementById('submitted-photo-link').href = url;
            photoWrap.hidden = false;
          } else photoWrap.hidden = true;
        } else photoWrap.hidden = true;
      } else {
        panel.hidden = true;
      }

      document.getElementById('editor').hidden = false;
    }

    async function decideSubmission(newStatus) {
      // newStatus: 'done' (approve) or 'planned' (reject / clear submission)
      editing.session.status = newStatus;
      editing.session.done_at = newStatus === 'done' ? new Date().toISOString() : null;
      // save (uses full session state, so any UI edits persist too)
      await saveSession();
    }

    function closeEditor() {
      document.getElementById('editor').hidden = true;
      editing = null;
    }

    async function saveSession() {
      const s = editing.session;
      s.title = document.getElementById('editor-title-input').value.trim();
      s.notes = document.getElementById('editor-notes').value.trim();

      // load the plan bucket for this week and upsert the session
      const weekStart = weekSaturdayOf(editing.dateIso);
      const plan = await loadOrInitPlan(supabase, editing.studentId, weekStart);
      const sessions = (plan.sessions || []).map((x) => ({ ...x, date: x.date || addDays(weekStart, x.day ?? 0) }));
      const idx = sessions.findIndex((x) => x.date === editing.dateIso);
      if (idx >= 0) sessions[idx] = s; else sessions.push(s);
      plan.sessions = sessions;

      const { error } = await savePlan(supabase, plan, coachId);
      if (error) {
        const msg = document.getElementById('editor-msg');
        msg.className = 'app-msg error'; msg.textContent = 'خطا: ' + error.message;
        return;
      }
      closeEditor();
      await refreshCalendar();
    }

    async function deleteSession() {
      if (!confirm('این جلسه حذف شود؟')) return;
      const weekStart = weekSaturdayOf(editing.dateIso);
      const plan = await loadOrInitPlan(supabase, editing.studentId, weekStart);
      const sessions = (plan.sessions || []).map((x) => ({ ...x, date: x.date || addDays(weekStart, x.day ?? 0) }))
        .filter((x) => x.date !== editing.dateIso);
      plan.sessions = sessions;
      await savePlan(supabase, plan, coachId);
      closeEditor();
      await refreshCalendar();
    }

    // Wire up editor buttons
    document.getElementById('editor-close').addEventListener('click', closeEditor);
    document.getElementById('editor-cancel').addEventListener('click', closeEditor);
    document.getElementById('editor-save').addEventListener('click', saveSession);
    document.getElementById('editor-delete').addEventListener('click', deleteSession);
    document.getElementById('submitted-approve').addEventListener('click', () => decideSubmission('done'));
    document.getElementById('submitted-reject').addEventListener('click', () => decideSubmission('planned'));
    document.querySelectorAll('.add-blk').forEach((b) => {
      b.addEventListener('click', () => {
        if (!editing) return;
        editing.session.blocks.push(newBlock(b.dataset.kind));
        renderBlocks();
      });
    });

    // Wire student picker
    document.getElementById('student-picker').addEventListener('change', (e) => {
      currentStudentId = e.target.value;
      renderCalendar();
    });

    async function refresh() {
      await fetchAllUsers();
      renderStudentPicker();
      renderPending();
      await refreshCalendar();
    }

    // ---------- Boot ----------
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { window.location.replace('/app/login'); return; }
      const { data: profile } = await supabase.from('profiles').select('*').eq('id', session.user.id).single();
      if (!profile || profile.role !== 'coach') {
        document.getElementById('loading').hidden = true;
        document.getElementById('denied').hidden = false;
        return;
      }
      coachId = profile.id;
      setupHeader();
      initCalendar();
      document.getElementById('loading').hidden = true;
      document.getElementById('content').hidden = false;
      document.getElementById('hero-sub').textContent = `سلام ${profile.full_name || ''}`;
      await refresh();
    })();
  </script>
</AppShell>
