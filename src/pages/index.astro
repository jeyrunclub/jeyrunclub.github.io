---
import Base from '../layouts/Base.astro';
import gallery from '../data/gallery.json';
import stats from '../data/stats.json';

const featured = gallery.photos.slice(0, 8).map((p, i) => ({ ...p, id: i + 1 }));
const heroFacts = stats.cards.slice(0, 3);
const fa = (n) => String(n).replace(/[0-9]/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d]);
---
<Base
  title="جیران — باشگاه دویدن، تریل و کوهستان | سالار پیری"
  description="باشگاه دو و کوهستان جیران. از اولین قدم تا خط پایان ماراتن و قله دماوند، کنار تو هستیم. کلاس‌های گروهی هر روز ۶ صبح در تهران، برنامه‌ی اختصاصی، اردوی کوهستان."
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SportsClub',
    name: 'جیران — باشگاه دویدن، تریل و کوهستان',
    alternateName: 'Jeyrun Running Club',
    url: 'https://jeyrun.com',
    logo: 'https://jeyrun.com/images/logo.png',
    coach: {
      '@type': 'Person',
      name: 'سالار پیری',
      alternateName: 'Salar Piri',
      sameAs: [
        'https://www.strava.com/athletes/33620923',
        'https://www.instagram.com/salar.piri',
      ],
    },
    sameAs: [
      'https://www.instagram.com/jeyrun_club',
    ],
    address: { '@type': 'PostalAddress', addressLocality: 'Tehran', addressCountry: 'IR' },
  })} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">باشگاه دویدن، تریل و کوهستان · تهران</p>
        <h1>جیران</h1>
        <p class="tagline">از اولین قدم تا خط پایان ماراتن و قله دماوند، کنار تو هستیم.</p>
        <ul class="hero-facts">
          {heroFacts.map((f) => (
            <li><strong>{f.value}</strong>{f.label}</li>
          ))}
        </ul>
        <div class="hero-ctas">
          <a href="/#join" class="btn btn-primary">عضویت در تیم</a>
          <a href="/services" class="btn btn-ghost">خدمات</a>
        </div>
      </div>
      <div class="hero-portrait" aria-hidden="true">
        <div class="portrait-frame">
          <img src="/images/gallery/new-img_0169.jpg" alt="سالار پیری در دیوار قهرمانان مسابقه" />
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT (short) -->
  <section id="about" class="section about">
    <div class="container">
      <p class="section-eyebrow">درباره‌ی جیران</p>
      <h2>یک باشگاه، یک خانواده</h2>
      <div class="about-grid">
        <div class="about-text">
          <p>
            جیران باشگاه دو استقامت، تریل و کوهستان است — تأسیس‌شده توسط <a href="/coach"><strong>سالار پیری</strong></a>،
            یکی از برترین دوندگان اولترای ایران. رویکرد ما تمرین اصولی، پایدار و متناسب با هدف
            هر دونده است، از تازه‌کار تا حرفه‌ای.
          </p>
          <p>
            هر روز ساعت ۶ صبح در نقاط مختلف تهران و اطراف کنار هم می‌دویم؛ و برای هر عضو، برنامه‌ی
            اختصاصی نوشته می‌شود.
          </p>
          <blockquote class="values">
            ارزش‌های ما: <strong>دوستی · نظم · احترام · پیشرفت</strong>
          </blockquote>
          <p><a href="/coach" class="learn-more">دیدن پروفایل مربی ←</a></p>
        </div>
        <aside class="about-highlights">
          <div class="highlight"><span class="hl-num">۲:۳۴:۵۳</span><span class="hl-label">رکورد ماراتن سالار</span></div>
          <div class="highlight"><span class="hl-num">UTMB ۷۳۹</span><span class="hl-label">۲ سکوی بین‌المللی</span></div>
          <div class="highlight"><span class="hl-num">#۹</span><span class="hl-label">ITRA ایران</span></div>
          <div class="highlight"><span class="hl-num">۶ صبح</span><span class="hl-label">هر روز، ۶ نقطه در تهران</span></div>
        </aside>
      </div>
    </div>
  </section>

  <!-- SERVICES preview -->
  <section id="services" class="section services">
    <div class="container">
      <p class="section-eyebrow">خدمات</p>
      <h2>چه چیزی از جیران می‌گیری؟</h2>
      <div class="service-grid">
        <a href="/services#private" class="service-card">
          <span class="service-emoji">🦌</span><h3>کلاس خصوصی</h3>
          <p>تمرین یک‌به‌یک، بازخورد لحظه‌ای، سریع‌ترین راه پیشرفت.</p>
        </a>
        <a href="/services#group" class="service-card">
          <span class="service-emoji">🏃</span><h3>کلاس گروهی</h3>
          <p>هر روز ۶ صبح — کشوری، لواسان، درکه، قوچک، ولایت، یاس فاطمی.</p>
        </a>
        <a href="/services#online" class="service-card">
          <span class="service-emoji">💻</span><h3>برنامه‌ی آنلاین</h3>
          <p>برنامه‌ی اختصاصی هفتگی برای دوندگانی که خارج از تهران‌اند.</p>
        </a>
        <a href="/services#mountain" class="service-card">
          <span class="service-emoji">🏔️</span><h3>اردوی کوهستان</h3>
          <p>برنامه‌های تریل و صعود — از توچال تا دماوند.</p>
        </a>
        <a href="/services#race-prep" class="service-card">
          <span class="service-emoji">🏅</span><h3>آمادگی مسابقه</h3>
          <p>۵، ۱۰، ۲۱ و ماراتن — با پلن اختصاصی تا خط پایان.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section id="team" class="section testimonials">
    <div class="container">
      <p class="section-eyebrow">اعضای تیم</p>
      <h2>حرف اعضای جیران</h2>
      <div class="testimonial-grid">
        <figure class="testimonial-card">
          <img src="/images/team/afsaneh.jpg" alt="افسانه ولیزاده" class="testimonial-avatar" />
          <blockquote><p>جیران یعنی خانواده. هم می‌دوام، هم رکورد می‌زنم، هم کلی بهم خوش می‌گذره 😆🤝😍</p></blockquote>
          <figcaption><strong>افسانه ولیزاده</strong><span>عضو تیم جیران</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- MEDIA -->
  <section id="media" class="section media">
    <div class="container">
      <p class="section-eyebrow">رسانه</p>
      <h2>گفت‌وگو با سالار</h2>
      <p class="section-sub">سالار درباره‌ی تجربه‌ی دویدن، تمرین حرفه‌ای و مسیر تبدیل شدن به یک اولترا رانر.</p>
      <div class="video-wrap">
        <iframe
          src="https://www.youtube-nocookie.com/embed/9IzexbAlqrQ"
          title="مصاحبه‌ی سالار پیری"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <!-- GALLERY preview -->
  <section id="gallery-preview" class="section gallery">
    <div class="container">
      <p class="section-eyebrow">گالری</p>
      <h2>لحظه‌های جیران</h2>
      <div class="gallery-grid">
        {featured.map((p) => (
          <a href={`/photo/${p.id}`} class="gal-item">
            <span class="gal-badge">#{fa(p.id)}</span>
            <img src={`/images/gallery/${p.file}`} alt={p.title || `عکس شماره ${p.id}`} loading="lazy" />
            <span class="gal-caption">
              {p.title && <strong>{p.title}</strong>}
              {p.story && <span>{p.story}</span>}
            </span>
          </a>
        ))}
      </div>
      <p class="ig-follow"><a href="/gallery">دیدن همه‌ی عکس‌ها ({fa(gallery.photos.length)}) ←</a></p>
    </div>
  </section>

  <!-- JOIN -->
  <section id="join" class="section join">
    <div class="container join-inner">
      <div>
        <p class="section-eyebrow">عضویت</p>
        <h2>به جیران بپیوند</h2>
        <p>
          چه تازه شروع کرده‌ای، چه دنبال اولین ماراتن یا صعود دماوند هستی — با یک پیام واتس‌اپ، شروع کن.
          سالار برای شرایط، هدف و برنامه‌ی روزانه‌ات، تمرین اختصاصی می‌نویسد.
        </p>
      </div>
      <div class="join-actions">
        <a class="btn btn-whatsapp" href="https://wa.me/989128889975?text=%D8%B3%D9%84%D8%A7%D9%85%20%D8%B3%D8%A7%D9%84%D8%A7%D8%B1%D8%8C%20%D8%A8%D8%B1%D8%A7%DB%8C%20%D8%B9%D8%B6%D9%88%DB%8C%D8%AA%20%D8%AF%D8%B1%20%D8%AC%DB%8C%D8%B1%D8%A7%D9%86%20%D9%BE%DB%8C%D8%A7%D9%85%20%D9%85%DB%8C%E2%80%8C%D8%AF%D9%87%D9%85." target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.05 21.785h-.004a9.87 9.87 0 01-5.03-1.378l-.36-.214-3.741.982.999-3.648-.235-.374a9.86 9.86 0 01-1.511-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.892 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>پیام در واتس‌اپ</span>
        </a>
        <p class="join-note">پاسخ معمولاً در کمتر از ۲۴ ساعت.<br /><span dir="ltr" style="unicode-bidi: isolate;">+98 912 888 9975</span></p>
      </div>
    </div>
  </section>

</Base>
