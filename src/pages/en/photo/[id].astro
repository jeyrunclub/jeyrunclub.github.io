---
import Base from '../../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { photos, FULL_WIDTHS, FULL_QUALITY, CARD_WIDTH, CARD_QUALITY } from '../../../lib/gallery.js';

export function getStaticPaths() {
  // params come from photo.id, not the array position — gallery.json has an
  // entry whose file is missing, so the two diverge after it.
  return photos.map((photo, i) => ({
    params: { id: String(photo.id) },
    props: {
      photo: {
        ...photo,
        title: photo.title_en || photo.title,
        story: photo.story_en || photo.story,
      },
      number: photo.id,
      prev: i > 0 ? photos[i - 1].id : null,
      next: i < photos.length - 1 ? photos[i + 1].id : null,
      total: photos.length,
    },
  }));
}

const { photo, number, prev, next, total } = Astro.props;

// Each photo gets its own social card, as a JPEG for crawler compatibility.
const card = await getImage({ src: photo.image, format: 'jpeg', width: CARD_WIDTH, quality: CARD_QUALITY });
---
<Base
  lang="en"
  title={`Photo #${number} — ${photo.title || 'Jeyrun gallery'}`}
  description={photo.story || photo.title || `Photo ${number} from the Jeyrun gallery`}
  ogImage={card.src}
>
  <section class="photo-page">
    <div class="container photo-inner">
      <p class="photo-crumb">
        <a href="/en/gallery">← Back to gallery</a>
        <span class="photo-num">Photo #{number} of {total}</span>
      </p>

      <figure class="photo-hero">
        <Image
          src={photo.image}
          alt={photo.title || `Photo ${number}`}
          widths={FULL_WIDTHS}
          sizes="(max-width: 900px) 94vw, 860px"
          quality={FULL_QUALITY}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="photo-meta">
        {photo.title && <h1>{photo.title}</h1>}
        {photo.story ? (
          <p class="photo-story">{photo.story}</p>
        ) : (
          <p class="photo-story photo-story-empty">
            No story yet for this photo.
            <br />
            <em>Want to add one? Tell Salar: "story for photo #{number} …"</em>
          </p>
        )}
      </div>

      <nav class="photo-nav">
        {prev ? (
          <a href={`/en/photo/${prev}`} class="btn btn-ghost">← Prev (#{prev})</a>
        ) : <span></span>}
        <a href="/en/gallery" class="btn btn-ghost">All photos</a>
        {next ? (
          <a href={`/en/photo/${next}`} class="btn btn-ghost">Next (#{next}) →</a>
        ) : <span></span>}
      </nav>
    </div>
  </section>
</Base>
