---
import Base from '../../../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import { photos, ordered, FULL_WIDTHS, FULL_QUALITY, CARD_WIDTH, CARD_QUALITY } from '../../../lib/gallery.js';

export function getStaticPaths() {
  // params come from photo.id, not the array position — gallery.json has an
  // entry whose file is missing, so the two diverge after it.
  // URLs key off photo.id; prev/next and the position walk `ordered`, so
  // stepping through matches the grid. See src/pages/photo/[id].astro.
  return photos.map((photo) => {
    const i = ordered.findIndex((p) => p.id === photo.id);
    return {
      params: { id: String(photo.id) },
      props: {
        photo: {
          ...photo,
          title: photo.title_en || photo.title,
          story: photo.story_en || photo.story,
        },
        position: i + 1,
        prev: i > 0 ? ordered[i - 1].id : null,
        next: i < ordered.length - 1 ? ordered[i + 1].id : null,
        total: ordered.length,
      },
    };
  });
}

const { photo, position, prev, next, total } = Astro.props;

// Each photo gets its own social card, as a JPEG for crawler compatibility.
const card = await getImage({ src: photo.image, format: 'jpeg', width: CARD_WIDTH, quality: CARD_QUALITY });
---
<Base
  lang="en"
  title={`${photo.title || 'Jeyrun gallery'} — Jeyrun photos`}
  description={photo.story || photo.title || 'A photo from the Jeyrun club gallery'}
  ogImage={card.src}
>
  <section class="photo-page">
    <div class="container photo-inner">
      <p class="photo-crumb">
        <a href="/en/gallery">← Back to gallery</a>
        <span class="photo-num">Photo {position} of {total}</span>
      </p>

      <figure class="photo-hero">
        <Image
          src={photo.image}
          alt={photo.title || `Photo ${position}`}
          widths={FULL_WIDTHS}
          sizes="(max-width: 900px) 94vw, 860px"
          quality={FULL_QUALITY}
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <div class="photo-meta">
        {photo.title && <h1>{photo.title}</h1>}
        {photo.story ? (
          <p class="photo-story">{photo.story}</p>
        ) : (
          <p class="photo-story photo-story-empty">
            No story yet for this photo.
            <br />
            <em>Want to add one? Tell Salar which photo it is.</em>
          </p>
        )}
      </div>

      {/* See src/pages/photo/[id].astro — same prefetch and key handling. */}
      <nav class="photo-nav">
        {prev ? (
          <a href={`/en/photo/${prev}`} class="btn btn-ghost" data-photo-prev data-astro-prefetch="viewport">← Prev</a>
        ) : <span></span>}
        <a href="/en/gallery" class="btn btn-ghost">All photos</a>
        {next ? (
          <a href={`/en/photo/${next}`} class="btn btn-ghost" data-photo-next data-astro-prefetch="viewport">Next →</a>
        ) : <span></span>}
      </nav>

      <p class="photo-keyhint">You can also step through with <kbd>←</kbd> and <kbd>→</kbd>.</p>
    </div>
  </section>

  <script>
    {
      const go = (sel) => {
        const a = document.querySelector(sel);
        if (a instanceof HTMLAnchorElement) window.location.href = a.href;
      };
      document.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        const rtl = document.documentElement.dir === 'rtl';
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(rtl ? '[data-photo-next]' : '[data-photo-prev]'); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); go(rtl ? '[data-photo-prev]' : '[data-photo-next]'); }
      });
    }
  </script>
</Base>
