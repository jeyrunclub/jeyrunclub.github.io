---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { ordered, THUMB_WIDTHS, THUMB_QUALITY, GRID_SIZES } from '../../lib/gallery.js';

// Every photo, in one masonry, group shots first.
//
// This used to render 24 and append the rest on a button. In a column
// masonry an append is the one thing you cannot do quietly: the columns
// rebalance, so the photographs already on screen jump to new positions and
// the new ones land wherever the balancing puts them rather than at the
// bottom. Rendering the lot removes the problem rather than managing it —
// and costs nothing, because every image below the fold is lazy.
const photos = ordered.map((p) => ({ ...p, title: p.title_en || p.title, story: p.story_en || p.story }));
---
<Base
  lang="en"
  title="Gallery — Jeyrun | Training, Racing and the Mountains"
  description="Photos from Jeyrun Running Club — training mornings, races, mountain camps and summits."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">Gallery</p>
      <h1>Moments of Jeyrun</h1>
      <p class="lead">
        Photos from training, races, mountain camps and everyday team moments. Tap a photo to see its story.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="gallery-grid">
        {photos.map((p, i) => (
          <a href={`/en/photo/${p.id}`} class="gal-item">
            <Image
              src={p.image}
              alt={p.title || 'A photo from the Jeyrun gallery'}
              widths={THUMB_WIDTHS}
              sizes={GRID_SIZES}
              quality={THUMB_QUALITY}
              loading={i < 8 ? 'eager' : 'lazy'}
            />
            <span class="gal-caption">
              {p.title && <strong>{p.title}</strong>}
              {p.story && <span>{p.story}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
