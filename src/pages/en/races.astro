---
import Base from '../../layouts/Base.astro';
import targetRaces from '../../data/target-races.json';

// The marathons the team is training for and travels to as a group.
const targets = targetRaces.races;

// Other things on the calendar — camps and home races.
const upcoming = [
  { name: 'Mahan (Kerman)', date: '', city: 'Kerman, Iran', note: 'A desert race — a completely different running experience across the Kerman desert.' },
  { name: 'Damavand ascent', date: '', city: 'Mazandaran, Iran', note: "Our annual summit of the Middle East's tallest peak." },
];
---
<Base
  lang="en"
  title="Races — Jeyrun | Istanbul, Valencia and Dubai Marathons"
  description="Jeyrun's target races: the Istanbul, Valencia and Dubai marathons — plus the Damavand ascent and Mahan (Kerman)."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">Races</p>
      <h1>Jeyrun races</h1>
      <p class="lead">
        Jeyrun isn't just a training club — it's a traveling one. Each year we plan and run several
        races and camps together as a team.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-eyebrow">Target races</p>
      <h2>What we are training for</h2>
      <p class="section-sub">
        The three marathons Jeyrun builds its season around and travels to as a group.
        Every member's training plan is written backwards from these dates.
      </p>
      <div class="target-grid">
        {targets.map((r, i) => (
          <article class="target-card">
            <span class="target-index" aria-hidden="true">{i + 1}</span>
            <p class="target-when">{r.when_en}</p>
            <h3>{r.name_en}</h3>
            <p class="target-city">{r.city_en}</p>
            <span class="target-dist" dir="ltr">{r.distance_en}</span>
            <p class="target-blurb">{r.blurb_en}</p>
          </article>
        ))}
      </div>
      <p class="section-sub" style="margin-top: 28px;">
        Exact dates and registration windows are announced in the WhatsApp group.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Also on the calendar</h2>
      <div class="race-list">
        {upcoming.map((r) => (
          <div class="race-card">
            <div class="race-medal finish">📍</div>
            <div class="race-info">
              <h3>{r.name}</h3>
              <p>{[r.date, r.city].filter(Boolean).join(' · ') || 'Date TBA'}</p>
              <p>{r.note}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="section-sub" style="margin-top: 40px;">
        For exact dates and registration for each event, join the Jeyrun WhatsApp group.
      </p>
      <a class="btn btn-primary" href="https://wa.me/989128889975" target="_blank" rel="noopener">Join the group</a>
    </div>
  </section>
</Base>
