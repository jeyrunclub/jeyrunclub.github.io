---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RunnersBand from '../../components/RunnersBand.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import { Image } from 'astro:assets';
import { byFile, photos as galleryPhotos, featured as groupShots, THUMB_WIDTHS, THUMB_QUALITY, GRID_SIZES } from '../../lib/gallery.js';
// See src/pages/index.astro.
import heroPhoto from '../../assets/gallery/new-img_2412.jpg';
import gallery from '../../data/gallery.json';
import targetRaces from '../../data/target-races.json';
import memberResults from '../../data/member-results.json';

const featured = groupShots.map((p) => ({
  ...p,
  title: p.title_en || p.title,
  story: p.story_en || p.story,
}));
const targets = targetRaces.races;

const why = [
  { icon: 'group', title: 'Group training', desc: 'Every day at 6 AM, at seven points across Tehran and the hills around it.' },
  { icon: 'stopwatch', title: 'A plan of your own', desc: 'A weekly plan written for your goal, your fitness and your week — not a template.' },
  { icon: 'flag', title: 'Race preparation', desc: 'From a first 5K to a marathon — an 8-to-16 week build and a race-day strategy.' },
  { icon: 'peak', title: 'Trail & mountain', desc: 'The Lavasan and Qouchak trails, altitude camps and the Damavand summit.' },
  { icon: 'globe', title: 'Camps & races abroad', desc: 'Travelling as a team to marathons and trail races outside Iran, coached throughout.' },
];

const results = memberResults.results;

// Last light, the largest team frame there is.
const quoteBand = byFile('new-img_7752.jpg');

const partnerRoutes = [
  { icon: 'handshake', title: 'Athlete sponsorship', desc: 'Long-term partnerships with sports, nutrition, apparel and gear brands.', href: '/en/partners#sponsorship' },
  { icon: 'pace', title: 'Race pacing', desc: 'Hit your target time behind a steady, planned pace.', href: '/en/partners#pacing' },
  { icon: 'route', title: 'Brand events', desc: 'Idea to final report — a real event with a real running community.', href: '/en/partners#events' },
];
---
<Base
  lang="en"
  title="Jeyrun — Running, Trail & Mountain Club | Salar Piri"
  description="Jeyrun Running & Mountain Club. From your first step to the marathon finish line and the summit of Damavand, we run with you. Daily 6 AM sessions in Tehran, custom plans, mountain camps."
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SportsClub',
    name: 'Jeyrun Running & Mountain Club',
    alternateName: 'جیران',
    url: 'https://jeyrun.com/en',
    logo: 'https://jeyrun.com/images/logo.png',
    coach: {
      '@type': 'Person',
      name: 'Salar Piri',
      alternateName: 'سالار پیری',
      sameAs: [
        'https://www.strava.com/athletes/33620923',
        'https://www.instagram.com/salar.piri',
      ],
    },
    sameAs: ['https://www.instagram.com/jeyrun_club'],
    address: { '@type': 'PostalAddress', addressLocality: 'Tehran', addressCountry: 'IR' },
  })} />

  <!-- HERO -->
  <section class="hero hero-photo">
    <Image
      src={heroPhoto}
      alt="Team Jeyrun on a morning speed session"
      class="hero-photo-img"
      widths={[900, 1400, 1900]}
      sizes="100vw"
      quality={74}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Running, Trail & Mountain Club · Tehran</p>
        <h1>Jeyrun</h1>
        <p class="tagline">From your first step to the marathon finish line and the summit of Damavand — we run with you.</p>
        <ul class="hero-facts">
          <li><strong>2:34:53</strong>Marathon PR</li>
          <li><strong>1:14:50</strong>Half PR</li>
          <li><strong>34:39</strong>10K PR</li>
          <li><strong>UTMB 739</strong>Best score</li>
          <li><strong>#9</strong>ITRA Iran</li>
        </ul>
        <div class="hero-ctas">
          <a href="/en#join" class="btn btn-primary">Join the team</a>
          <a href="/en/services" class="btn btn-ghost">Our services</a>
        </div>
      </div>
    </div>
  </section>



  <!-- WHY JEYRUN -->
  <section id="why" class="section why">
    <div class="container">
      <p class="section-eyebrow">Why Jeyrun?</p>
      <h2>Jeyrun services</h2>
      <div class="why-grid">
        {why.map((w) => (
          <article class="why-card">
            <span class="why-icon"><Icon name={w.icon} size={26} /></span>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Members' results — see the Persian homepage for why this block earns its
      place. Renders only once src/data/member-results.json has entries. */}
  {results.length > 0 && (
    <section id="results" class="section results">
      <div class="container">
        <p class="section-eyebrow">Members' results</p>
        <h2>What Jeyrun runners have done</h2>
        <p class="section-sub">Personal bests and race results from runners training on a Jeyrun plan.</p>
        <div class="results-grid">
          {results.map((r) => {
            const name = r.name_en || r.name;
            return (
              <article class="result-card">
                {r.photo
                  ? <img src={r.photo} alt={name} class="result-photo" />
                  : <span class="result-initial" aria-hidden="true">{name.trim().charAt(0)}</span>}
                <div>
                  <h3 class="result-name">{name}</h3>
                  <p class="result-race">{[r.race_en || r.race, r.year_en || r.year].filter(Boolean).join(' · ')}</p>
                  {(r.time_en || r.time) && <span class="result-time" dir="ltr">{r.time_en || r.time}</span>}
                  {(r.note_en || r.note) && <p class="result-note">{r.note_en || r.note}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT -->
  <section id="about" class="section about">
    <div class="container">
      <p class="section-eyebrow">About Jeyrun</p>
      <h2>One club, one family</h2>
      <div class="about-grid">
        <div class="about-text">
          <p>
            Jeyrun is an endurance running, trail and mountain club, founded by
            <a href="/en/coach"><strong>Salar Piri</strong></a> — one of Iran's leading ultra runners.
            Our approach: consistent, structured training tailored to each runner, from first-timer to elite.
          </p>
          <p>
            Every day at 6 AM we meet across different points of Tehran and the surrounding mountains,
            and every member gets a training plan written for them.
          </p>
          <blockquote class="values">
            Our values: <strong>Friendship · Discipline · Respect · Progress</strong>
          </blockquote>
          <p><a href="/en/coach" class="learn-more">Meet the coach →</a></p>
        </div>
        <aside class="about-highlights">
          <div class="highlight"><span class="hl-num">2:34:53</span><span class="hl-label">Salar's marathon PR</span></div>
          <div class="highlight"><span class="hl-num">7:39:59</span><span class="hl-label">100 km PR (4:33 pace)</span></div>
          <div class="highlight"><span class="hl-num">UTMB 739</span><span class="hl-label">2 int'l podiums</span></div>
          <div class="highlight"><span class="hl-num">#9</span><span class="hl-label">ITRA Iran ranking</span></div>
        </aside>
      </div>
    </div>
  </section>

  <!-- SERVICES preview -->
  <RunnersBand />

  <section id="services" class="section services">
    <div class="container">
      <p class="section-eyebrow">Services</p>
      <h2>What you get from Jeyrun</h2>
      <div class="service-grid">
        <a href="/en/services#private" class="service-card">
          <span class="service-emoji"><Icon name="stopwatch" size={28} /></span><h3>Private coaching</h3>
          <p>One-to-one training, instant feedback — the fastest path to progress.</p>
        </a>
        <a href="/en/services#group" class="service-card">
          <span class="service-emoji"><Icon name="group" size={28} /></span><h3>Group class</h3>
          <p>Every day 6 AM — Keshvari, Enghelab, Lavasan, Darakeh, Qouchak, Velayat, Yas.</p>
        </a>
        <a href="/en/services#online" class="service-card">
          <span class="service-emoji"><Icon name="screen" size={28} /></span><h3>Online program</h3>
          <p>Personalized weekly plans for runners outside Tehran, worldwide.</p>
        </a>
        <a href="/en/services#mountain" class="service-card">
          <span class="service-emoji"><Icon name="peak" size={28} /></span><h3>Mountain camp</h3>
          <p>Trail and summit programs — from Tochal to Damavand.</p>
        </a>
        <a href="/en/services#race-prep" class="service-card">
          <span class="service-emoji"><Icon name="flag" size={28} /></span><h3>Race prep</h3>
          <p>5K, 10K, half, marathon — with a bespoke plan to the finish line.</p>
        </a>
      </div>
    </div>
  </section>
  <!-- TARGET RACES -->
  <section id="target-races" class="section target-races">
    <div class="container">
      <p class="section-eyebrow">Target races</p>
      <h2>What we are training for</h2>
      <p class="section-sub">
        The three marathons Jeyrun builds its season around and travels to as a group.
      </p>
      <div class="target-grid">
        {targets.map((r, i) => (
          <article class="target-card">
            <span class="target-index" aria-hidden="true">{i + 1}</span>
            <p class="target-when">{r.when_en}</p>
            <h3>{r.name_en}</h3>
            <p class="target-city">{r.city_en}</p>
            <span class="target-dist" dir="ltr">{r.distance_en}</span>
          </article>
        ))}
      </div>
      <p style="margin-top: 28px;"><a href="/en/races" class="learn-more">All races and camps →</a></p>
    </div>
  </section>

  {/* The Persian homepage carries this quote; the English one had no member
      voice at all. Translated, and said over the club at full strength. */}
  <PhotoBand
    photo={quoteBand}
    quote="Jeyrun means family. I run, I set personal bests, and I have a great time doing it."
    by="Afsaneh Valizadeh"
    role="Jeyrun team member"
    size="tall"
  />

  <!-- MEDIA -->
  <section id="media" class="section media">
    <div class="container">
      <p class="section-eyebrow">Media</p>
      <h2>Conversation with Salar</h2>
      <p class="section-sub">Salar on running, structured training, and the path to becoming an ultra runner (Persian audio).</p>
      <div class="video-wrap">
        <iframe
          src="https://www.youtube-nocookie.com/embed/9IzexbAlqrQ"
          title="Salar Piri interview"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <!-- GALLERY preview -->
  <section id="gallery-preview" class="section gallery">
    <div class="container">
      <p class="section-eyebrow">Gallery</p>
      <h2>Moments from Jeyrun</h2>
      <div class="gallery-grid">
        {featured.map((p) => (
          <a href={`/en/photo/${p.id}`} class={`gal-item is-${p.shape}`}>
            <Image
              src={p.image}
              alt={p.title || `Photo ${p.id}`}
              widths={THUMB_WIDTHS}
              sizes={GRID_SIZES}
              quality={THUMB_QUALITY}
              loading="lazy"
            />
            <span class="gal-caption">
              {p.title && <strong>{p.title}</strong>}
              {p.story && <span>{p.story}</span>}
            </span>
          </a>
        ))}
      </div>
      <p class="ig-follow"><a href="/en/gallery">See all photos →</a></p>
    </div>
  </section>

  <!-- PARTNERSHIPS -->
  <section id="sponsor" class="section sponsor">
    <div class="container">
      <p class="section-eyebrow">Sponsorship &amp; Partnerships</p>
      <h2>Partner with Salar and Jeyrun</h2>
      <p class="section-sub">
        Jeyrun builds audience, content, events, race presence and sporting credibility for brands.
        Three routes to work together:
      </p>
      <div class="why-grid">
        {partnerRoutes.map((r) => (
          <a href={r.href} class="why-card">
            <span class="why-icon"><Icon name={r.icon} size={26} /></span>
            <h3>{r.title}</h3>
            <p>{r.desc}</p>
          </a>
        ))}
      </div>
      <p style="margin-top: 28px;"><a href="/en/partners" class="learn-more">See all three routes →</a></p>
    </div>
  </section>

  <!-- JOIN -->
  <section id="join" class="section join">
    <div class="container join-inner">
      <div>
        <p class="section-eyebrow">Join</p>
        <h2>Join Jeyrun</h2>
        <p>
          Whether you're just starting out, chasing your first marathon, or planning a Damavand summit
          — one WhatsApp message gets you started. Salar writes each plan for the runner in front of him.
        </p>
      </div>
      <div class="join-actions">
        <a class="btn btn-whatsapp" href="https://wa.me/989128889975?text=Hi%20Salar%2C%20I%27d%20like%20to%20join%20Jeyrun." target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.05 21.785h-.004a9.87 9.87 0 01-5.03-1.378l-.36-.214-3.741.982.999-3.648-.235-.374a9.86 9.86 0 01-1.511-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.892 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>Message on WhatsApp</span>
        </a>
        <p class="join-note">Usually a reply within 24 hours.<br /><span dir="ltr">+98 912 888 9975</span></p>
      </div>
    </div>
  </section>

</Base>
