---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { Image } from 'astro:assets';
import { byFile, CARD_WIDTHS, CARD_SIZES, CARD_QUALITY } from '../lib/gallery.js';
import targetRaces from '../data/target-races.json';

// The marathons the team is training for and travels to as a group.
const targets = targetRaces.races;

// Other things on the calendar — camps and home races.
const upcoming = [
  { name: 'صعود دماوند', date: '', city: 'مازندران، ایران',
    photo: 'new-img_6742.jpg',
    note: 'اردوی سالانه‌ی صعود بلندترین قله‌ی خاورمیانه.' },
  { name: 'ماهان کرمان', date: '', city: 'کرمان، ایران',
    photo: 'new-img_9128.jpg',
    note: 'مسابقه‌ی کویری — تجربه‌ی متفاوت دویدن در دل کویر.' },
].map((r) => ({ ...r, frame: byFile(r.photo) }));

// The team under Damavand, the whole reason the travel races exist.
const heroBand = byFile('group-b.jpg');
---
<Base
  title="مسابقات جیران — ماراتن استانبول، والنسیا، دبی"
  description="مسابقات هدف تیم جیران: ماراتن استانبول، ماراتن والنسیا و ماراتن دبی — به همراه اردوی دماوند و ماهان کرمان."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">مسابقات</p>
      <h1>مسابقات جیران</h1>
      <p class="lead">
        جیران فقط یک باشگاه تمرین نیست — یک هم‌سفر است. هر سال چند مسابقه و اردو را به صورت
        گروهی برنامه‌ریزی و برگزار می‌کنیم.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-eyebrow">مسابقات هدف</p>
      <h2>برای این مسابقات تمرین می‌کنیم</h2>
      <p class="section-sub">
        سه ماراتنی که تیم جیران برای‌شان برنامه می‌چیند و گروهی به آن‌ها سفر می‌کند.
        برنامه‌ی تمرینی هر عضو روی تاریخ همین مسابقه‌ها بسته می‌شود.
      </p>
      <div class="target-grid">
        {targets.map((r, i) => (
          <article class="target-card">
            <span class="target-index" aria-hidden="true">{['۱', '۲', '۳'][i]}</span>
            <p class="target-when">{r.when}</p>
            <h3>{r.name}</h3>
            <p class="target-city">{r.city}</p>
            <span class="target-dist" dir="ltr">{r.distance}</span>
            <p class="target-blurb">{r.blurb}</p>
          </article>
        ))}
      </div>
      <p class="section-sub" style="margin-top: 28px;">
        تاریخ دقیق و پنجره‌ی ثبت‌نام هر مسابقه در گروه واتساپ اعلام می‌شود.
      </p>
    </div>
  </section>

  <PhotoBand
    photo={heroBand}
    quote="هر سال، گروهی به خط استارت می‌رسیم."
    size="band"
  />

  <section class="section">
    <div class="container">
      <h2>دیگر برنامه‌های تیم</h2>
      {/* Two entries in the narrow .race-list left most of the row empty, so
          these use the photo card the services page uses: at two across they
          fill the width, and each one shows the place it is talking about. */}
      <div class="trip-grid">
        {upcoming.map((r) => (
          <article class="trip-card">
            <a href={`/photo/${r.frame.id}`} class="trip-photo" aria-label={r.frame.title}>
              <Image
                src={r.frame.image}
                alt={r.frame.title}
                widths={CARD_WIDTHS}
                sizes={CARD_SIZES}
                quality={CARD_QUALITY}
                loading="lazy"
              />
            </a>
            <div class="trip-body">
              <div class="trip-icon"><Icon name="route" size={22} /></div>
              <h3>{r.name}</h3>
              <p class="trip-where">{[r.date, r.city].filter(Boolean).join(' · ') || 'تاریخ اعلام خواهد شد'}</p>
              <p>{r.note}</p>
            </div>
          </article>
        ))}
      </div>

      <p class="section-sub" style="margin-top: 40px;">
        برای اطلاع از تاریخ دقیق و ثبت‌نام هر رویداد، در واتساپ عضو گروه جیران شو.
      </p>
      <a class="btn btn-primary" href="https://wa.me/989128889975" target="_blank" rel="noopener">پیوستن به گروه</a>
    </div>
  </section>
</Base>
