---
import Base from '../layouts/Base.astro';
import targetRaces from '../data/target-races.json';

// The marathons the team is training for and travels to as a group.
const targets = targetRaces.races;

// Other things on the calendar — camps and home races.
const upcoming = [
  { name: 'ماهان کرمان', date: '', city: 'کرمان، ایران', note: 'مسابقه‌ی کویری — تجربه‌ی متفاوت دویدن در دل کویر.' },
  { name: 'صعود دماوند', date: '', city: 'مازندران، ایران', note: 'اردوی سالانه‌ی صعود بلندترین قله‌ی خاورمیانه.' },
];
---
<Base
  title="مسابقات جیران — ماراتن استانبول، والنسیا، دبی"
  description="مسابقات هدف تیم جیران: ماراتن استانبول، ماراتن والنسیا و ماراتن دبی — به همراه اردوی دماوند و ماهان کرمان."
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">مسابقات</p>
      <h1>مسابقات جیران</h1>
      <p class="lead">
        جیران فقط یک باشگاه تمرین نیست — یک هم‌سفر است. هر سال چند مسابقه و اردو را به صورت
        گروهی برنامه‌ریزی و برگزار می‌کنیم.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-eyebrow">مسابقات هدف</p>
      <h2>برای این‌ها تمرین می‌کنیم</h2>
      <p class="section-sub">
        سه ماراتنی که تیم جیران برای‌شان برنامه می‌چیند و گروهی به آن‌ها سفر می‌کند.
        برنامه‌ی تمرینی هر عضو روی تاریخ همین مسابقه‌ها بسته می‌شود.
      </p>
      <div class="target-grid">
        {targets.map((r, i) => (
          <article class="target-card">
            <span class="target-index" aria-hidden="true">{['۱', '۲', '۳'][i]}</span>
            <p class="target-when">{r.when}</p>
            <h3>{r.name}</h3>
            <p class="target-city">{r.city}</p>
            <span class="target-dist" dir="ltr">{r.distance}</span>
            <p class="target-blurb">{r.blurb}</p>
          </article>
        ))}
      </div>
      <p class="section-sub" style="margin-top: 28px;">
        تاریخ دقیق و پنجره‌ی ثبت‌نام هر مسابقه در گروه واتس‌اپ اعلام می‌شود.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>دیگر برنامه‌های تیم</h2>
      <div class="race-list">
        {upcoming.map((r) => (
          <div class="race-card">
            <div class="race-medal finish">📍</div>
            <div class="race-info">
              <h3>{r.name}</h3>
              <p>{[r.date, r.city].filter(Boolean).join(' · ') || 'تاریخ اعلام خواهد شد'}</p>
              <p>{r.note}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="section-sub" style="margin-top: 40px;">
        برای اطلاع از تاریخ دقیق و ثبت‌نام هر رویداد، در واتس‌اپ عضو گروه جیران شو.
      </p>
      <a class="btn btn-primary" href="https://wa.me/989128889975" target="_blank" rel="noopener">پیوستن به گروه</a>
    </div>
  </section>
</Base>
