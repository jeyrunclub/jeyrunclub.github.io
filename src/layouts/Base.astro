---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: 'fa' | 'en';
}

const {
  title,
  description,
  ogImage = '/images/gallery/new-img_3475.jpg',
  lang = 'fa',
} = Astro.props;

const defaultDesc = {
  fa: 'باشگاه دویدن، تریل و کوهستان جیران — از اولین قدم تا خط پایان ماراتن و قله دماوند، کنار تو هستیم.',
  en: 'Jeyrun Running & Mountain Club — from your first step to the marathon finish line and the summit of Damavand, we run with you.',
} as const;

const desc = description ?? defaultDesc[lang];
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const dir = lang === 'fa' ? 'rtl' : 'ltr';
const ogLocale = lang === 'fa' ? 'fa_IR' : 'en_US';

// Compute alt-language URL for hreflang
const clean = Astro.url.pathname.replace(/\/$/, '') || '/';
const altPath = lang === 'fa'
  ? (clean === '/' ? '/en' : '/en' + clean)
  : (clean === '/en' ? '/' : clean.replace(/^\/en/, ''));
const altUrl = new URL(altPath, Astro.site).toString();
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'fa' ? 'en' : 'fa'} href={altUrl} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).toString()} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#df2747" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CJDCGQZF02"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CJDCGQZF02');
    </script>

    <slot name="head" />
  </head>
  <body class:list={[`lang-${lang}`]}>
    <Header lang={lang} />
    <main id="top">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.site-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        nav.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => {
            nav.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          })
        );
      }
    </script>
  </body>
</html>
