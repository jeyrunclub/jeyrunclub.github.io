---
import '../styles/app.css';
import { InstallPrompt } from '../components/app/InstallPrompt';

export interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} — جیران</title>
    <meta name="description" content="پنل اعضای باشگاه جیران" />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#df2747" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="جیران" />

    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CJDCGQZF02"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CJDCGQZF02');
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <slot />
    <InstallPrompt client:load />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
