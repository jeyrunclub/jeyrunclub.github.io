---
import '../styles/app.css';
import { ClientRouter } from 'astro:transitions';
import { InstallPrompt } from '../components/app/InstallPrompt';
import { NotifyPrompt } from '../components/app/NotifyPrompt';
import { RouteProgress } from '../components/app/RouteProgress';

export interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} — جیران</title>
    <meta name="description" content="پنل اعضای باشگاه جیران" />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&family=Lalezar&family=Space+Grotesk:wght@400;500;600;700&display=swap" />

    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#e00a2e" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="جیران" />

    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CJDCGQZF02"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CJDCGQZF02');
    </script>

    <!-- Client-side navigation inside /app.
         Every page here is a separate client:only island, so switching pages
         used to mean fetching a document, re-parsing ~400KB of React and
         booting a new root — about a second on a good connection and several
         on a bad one. With the router the runtime stays in memory and only
         the page's own chunk is evaluated. -->
    <ClientRouter />

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <RouteProgress client:load transition:persist />
    <slot />
    <InstallPrompt client:load />
    <NotifyPrompt client:load />
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
